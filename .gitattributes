# Normalise line endings in the repository. Shell scripts must stay LF:
# CRLF has broken shebangs on a Pi and produced phantom diffs.
* text=auto
*.sh text eol=lf

# The superseded PowerShell wrapper is kept for reference only and is stored
# with LF line ends like everything else.
*.ps1 text eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.zip binary
