<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="skin.functional" version="0.8.6" name="Functional" provider-name="c0def0rc0ffee">
	<requires>
		<!-- Kodi 21 (Omega) GUI version, matches the Flatpak build in use.
		     This is the value that installed cleanly before today. -->
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required for the service.py helper; kodi-addon-checker flags
		     services that don't declare the python API dependency. -->
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
	</extension>
	<extension point="xbmc.service" library="service.py" start="login" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Functional: a clean, opinionated Kodi skin</summary>
		<description lang="en_GB">Functional. Built for clarity: gallery library views, configurable accent colour, slide-out filters, side-by-side library stats on home, and a tight video OSD.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
<addon id="repository.functional" name="Functional Repository" version="1.0.1" provider-name="c0def0rc0ffee">
    <extension point="xbmc.addon.repository" name="Functional Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/c0def0rc0ffee/Functional/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/c0def0rc0ffee/Functional/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/c0def0rc0ffee/Functional/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Install and update the Functional skin</summary>
        <description lang="en_GB">Points Kodi at the Functional skin releases on GitHub. Install this once and Kodi keeps the skin up to date on its own.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
