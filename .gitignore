# Local release tooling and notes
/publish-github.sh
/push-source.sh
/publish.conf
/GITHUB-RELEASE-GUIDE.md
/.publish-allow
/Github repository
/PROJECT_NOTES.md
/release-mirror.conf

# Local build output / release artifacts (zips + working images)
/Skin Dist/
/Skin Git/

# Local editor and tooling state (any dot folder except .github)
.*/
!.github/

# Archives, temp files, logs never belong in the repo
*.zip
*.7z
*.log
*.tmp

# Windows recycle bin (project lives on a network share)
$RECYCLE.BIN/

# Python
__pycache__/
*.pyc

# Synology NAS sidecar metadata
@eaDir/
*@SynoEAStream

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Added 12/09/2026 (Linux packaging sweep)
# Internal ops docs, never published. One more entry lives in
# .git/info/exclude instead: this file ships, and that name must not.
/build.conf

# Secrets, both cases because matching is case sensitive. Nothing secret
# lives in this tree; the patterns stop one being added by accident.
.env
.env.*
*credential*
*CREDENTIAL*
*Credential*
*password*
*PASSWORD*
*Password*
*secret*
*SECRET*
*Secret*
*token*
*TOKEN*
*Token*
*cred*
*CRED*
*sftp*
*SFTP*
*ftp*
*FTP*
*.pem
*.key
*.pfx
id_rsa*
connection.txt
*config.local*
*.bak
