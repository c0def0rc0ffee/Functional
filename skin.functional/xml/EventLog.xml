<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Event Log window.

  Kodi-hardcoded control IDs:
     4  = "Show higher levels" togglebutton (filters informational events)
    20  = Action: Clear list
    21  = (unused here)
    22  = Show full description radiobutton
    50  = Events list (fixedlist)
    60  = Scrollbar
   501  = Open the Logging settings page
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<views>50</views>
	<controls>

		<include content="WindowBackground"/>
		<include content="HeaderBar">
			<param name="title" value="     Event Log"/>
		</include>

		<!-- Logo -->
		<control type="image">
			<left>20</left>
			<top>5</top>
			<width>80</width>
			<height>80</height>
			<aspectratio>keep</aspectratio>
			<texture>logo.png</texture>
		</control>

		<!-- ===== LEFT: FILTERS / ACTIONS ===== -->
		<control type="grouplist" id="9000">
			<left>40</left>
			<top>120</top>
			<width>360</width>
			<height>800</height>
			<itemgap>8</itemgap>
			<orientation>vertical</orientation>
			<onleft>9000</onleft>
			<onright>50</onright>

			<control type="togglebutton" id="4">
				<width>360</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>20</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<alttexturefocus colordiffuse="$VAR[AccentColor]">white.png</alttexturefocus>
				<alttexturenofocus colordiffuse="grey_mid">white.png</alttexturenofocus>
				<label>$LOCALIZE[31032]: $LOCALIZE[584]</label>
				<altlabel>$LOCALIZE[31032]: $LOCALIZE[585]</altlabel>
			</control>

			<control type="radiobutton" id="22">
				<width>360</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>20</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<textureradioonfocus colordiffuse="white">white.png</textureradioonfocus>
				<textureradioonnofocus colordiffuse="$VAR[AccentColor]">white.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="grey">white.png</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="grey_dark">white.png</textureradiooffnofocus>
				<label>Show description</label>
			</control>

			<control type="button" id="20">
				<width>360</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>20</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[192]</label>
			</control>

			<control type="button" id="501">
				<width>360</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>20</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[5]</label>
				<onclick>ActivateWindow(systemsettings,logging)</onclick>
			</control>
		</control>

		<!-- ===== RIGHT: EVENTS LIST ===== -->
		<control type="fixedlist" id="50">
			<left>440</left>
			<top>120</top>
			<width>1400</width>
			<height>820</height>
			<focusposition>4</focusposition>
			<movement>3</movement>
			<onleft>9000</onleft>
			<onright>60</onright>
			<onup>50</onup>
			<ondown>50</ondown>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<viewtype label="List">list</viewtype>

			<itemlayout height="90" width="1400">
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>70</width>
					<height>70</height>
					<aspectratio>keep</aspectratio>
					<texture fallback="DefaultAddon.png">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>100</left>
					<top>10</top>
					<width>980</width>
					<height>34</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>100</left>
					<top>46</top>
					<width>980</width>
					<height>30</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<label>$INFO[ListItem.Property(Event.Description)]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>10</top>
					<width>280</width>
					<height>34</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<align>right</align>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>

			<focusedlayout height="90" width="1400">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1400</width>
					<height>90</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(50)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1400</width>
					<height>90</height>
					<texture colordiffuse="40FFFFFF">white.png</texture>
					<visible>!Control.HasFocus(50)</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>70</width>
					<height>70</height>
					<aspectratio>keep</aspectratio>
					<texture fallback="DefaultAddon.png">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>100</left>
					<top>10</top>
					<width>980</width>
					<height>34</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>100</left>
					<top>46</top>
					<width>980</width>
					<height>30</height>
					<font>font_small</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<label>$INFO[ListItem.Property(Event.Description)]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>10</top>
					<width>280</width>
					<height>34</height>
					<font>font_small</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<align>right</align>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- Scrollbar -->
		<control type="scrollbar" id="60">
			<right>14</right>
			<top>120</top>
			<width>10</width>
			<height>820</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>50</onleft>
			<onright>9000</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="accent_hi">white.png</texturesliderbarfocus>
		</control>

		<!-- Empty-state hint -->
		<control type="label">
			<visible>Integer.IsEqual(Container(50).NumItems,0)</visible>
			<left>440</left>
			<top>440</top>
			<width>1400</width>
			<height>60</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>No events yet, they'll appear here as Kodi reports them.</label>
		</control>

	</controls>
</window>
