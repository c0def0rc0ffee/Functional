<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Kodi's colour picker (behind the subtitle colour setting among others):
  heading 1, the swatches in panel 6 with the colour value in Label2,
  scrollbar 61 and Cancel on 7. Ids from Estuary; styling this skin's.
  </summary>
-->
<window type="dialog">
	<defaultcontrol always="true">6</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>350</posx>
		<posy>145</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-350</left>
			<top>-145</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="80000000">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1220</width>
			<height>790</height>
			<texture colordiffuse="FF181C22">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1220</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<bottom>0</bottom>
			<width>1220</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<control type="label" id="1">
			<left>0</left>
			<top>20</top>
			<width>1220</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<!-- Kodi fills the panel; each item's Label2 is the colour value,
		     which is why the swatch takes it as its colordiffuse. -->
		<control type="panel" id="6">
			<left>20</left>
			<top>90</top>
			<width>880</width>
			<height>620</height>
			<orientation>vertical</orientation>
			<onleft>9001</onleft>
			<onright>61</onright>
			<onup>6</onup>
			<ondown>6</ondown>
			<pagecontrol>61</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout height="80" width="146">
				<control type="image">
					<left>8</left>
					<top>7</top>
					<width>130</width>
					<height>66</height>
					<texture>white.png</texture>
					<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
				</control>
			</itemlayout>
			<focusedlayout height="80" width="146">
				<control type="image">
					<left>2</left>
					<top>1</top>
					<width>142</width>
					<height>78</height>
					<texture colordiffuse="white" border="4">border.png</texture>
					<visible>Control.HasFocus(6)</visible>
				</control>
				<control type="image">
					<left>8</left>
					<top>7</top>
					<width>130</width>
					<height>66</height>
					<texture>white.png</texture>
					<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
				</control>
			</focusedlayout>
		</control>

		<control type="scrollbar" id="61">
			<left>910</left>
			<top>90</top>
			<width>12</width>
			<height>620</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>6</onleft>
			<onright>9001</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="$VAR[AccentHiColor]">white.png</texturesliderbarfocus>
		</control>

		<control type="label">
			<left>28</left>
			<top>730</top>
			<width>880</width>
			<height>40</height>
			<font>font_reg</font>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$LOCALIZE[737]:  $INFO[Container(6).ListItem.Label]  $INFO[Container(6).ListItem.Label2,#,]</label>
		</control>

		<control type="grouplist" id="9001">
			<left>940</left>
			<top>90</top>
			<width>260</width>
			<height>620</height>
			<orientation>vertical</orientation>
			<itemgap>10</itemgap>
			<onleft>61</onleft>
			<onright>6</onright>
			<control type="button" id="7">
				<width>260</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[222]</label>
			</control>
		</control>

	</controls>
</window>
