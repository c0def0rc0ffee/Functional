<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Power menu: a vertical grouplist 9000 of Kodi's fixed id buttons
  (shutdown, restart, quit and the rest) over a dimmed background.
  </summary>
-->
<window type="dialog">
	<defaultcontrol always="true">9000</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>660</posx>
		<posy>240</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-660</left>
			<top>-240</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>600</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>

		<control type="label" id="2">
			<left>0</left>
			<top>10</top>
			<width>600</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label>31040</label>
		</control>

		<!-- Panel: Kodi populates with item entries from this skin's content list -->
		<control type="panel" id="9000">
			<left>40</left>
			<top>80</top>
			<width>520</width>
			<height>480</height>
			<orientation>vertical</orientation>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<itemlayout height="60" width="520">
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="520">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>520</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(9000)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>31041</label>
					<onclick>Quit()</onclick>
					<visible>System.ShowExitButton</visible>
				</item>
				<item>
					<label>31042</label>
					<onclick>Powerdown()</onclick>
					<visible>System.CanPowerDown</visible>
				</item>
				<item>
					<label>31043</label>
					<onclick>Suspend()</onclick>
					<visible>System.CanSuspend</visible>
				</item>
				<item>
					<label>31044</label>
					<onclick>Hibernate()</onclick>
					<visible>System.CanHibernate</visible>
				</item>
				<item>
					<label>31045</label>
					<onclick>Reset()</onclick>
					<visible>System.CanReboot</visible>
				</item>
				<item>
					<label>31046</label>
					<onclick>System.LogOff</onclick>
					<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
				</item>
				<!-- Sleep timer. The row hands the work to service.py through
				     Skin.String(sleep_command), because the hours and minutes
				     prompt is a blocking Python dialog and a skin cannot open
				     one. The menu closes first: the prompt would otherwise
				     appear behind this dialog.

				     Both rows are switchable on their own from Skin Settings
				     (Home Screen), and the countdown readout has a separate
				     switch again, so the timer can run with nothing on screen. -->
				<item>
					<label>$VAR[SleepTimerMenuLabel]</label>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>Skin.SetString(sleep_command,set)</onclick>
					<visible>!Skin.HasSetting(hide_sleep_timer)</visible>
				</item>
				<!-- The two episode counted forms, only while something plays:
				     they count natural playback ends, so with nothing playing
				     there is nothing to count. -->
				<item>
					<label>31470</label>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>Skin.SetString(sleep_command,episode)</onclick>
					<visible>!Skin.HasSetting(hide_sleep_timer) + Player.HasMedia</visible>
				</item>
				<item>
					<label>31471</label>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>Skin.SetString(sleep_command,episodes)</onclick>
					<visible>!Skin.HasSetting(hide_sleep_timer) + Player.HasMedia</visible>
				</item>
				<item>
					<label>31425</label>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>Skin.SetString(sleep_command,cancel)</onclick>
					<visible>!Skin.HasSetting(hide_sleep_timer) + $EXP[sleep_armed]</visible>
				</item>
			</content>
		</control>

	</controls>
</window>
