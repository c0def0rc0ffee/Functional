<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">9000</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>660</posx>
		<posy>240</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-660</left>
			<top>-240</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>600</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>

		<control type="label" id="2">
			<left>0</left>
			<top>10</top>
			<width>600</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label>Power</label>
		</control>

		<!-- Panel: Kodi populates with item entries from this skin's content list -->
		<control type="panel" id="9000">
			<left>40</left>
			<top>80</top>
			<width>520</width>
			<height>480</height>
			<orientation>vertical</orientation>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<itemlayout height="60" width="520">
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="520">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>520</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(9000)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>Exit Kodi</label>
					<onclick>Quit()</onclick>
					<visible>System.ShowExitButton</visible>
				</item>
				<item>
					<label>Power Off</label>
					<onclick>Powerdown()</onclick>
					<visible>System.CanPowerDown</visible>
				</item>
				<item>
					<label>Suspend</label>
					<onclick>Suspend()</onclick>
					<visible>System.CanSuspend</visible>
				</item>
				<item>
					<label>Hibernate</label>
					<onclick>Hibernate()</onclick>
					<visible>System.CanHibernate</visible>
				</item>
				<item>
					<label>Reboot</label>
					<onclick>Reset()</onclick>
					<visible>System.CanReboot</visible>
				</item>
				<item>
					<label>Log Off</label>
					<onclick>System.LogOff</onclick>
					<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
				</item>
			</content>
		</control>

	</controls>
</window>
