<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<controls>

	<!--
	  The seek/pause bar is drawn as two complete copies, one anchored to the
	  bottom of the screen, one to the top, and the OSD Position setting simply
	  shows one and hides the other. This is the same visibility-gated pattern
	  the info strip uses and, unlike the previous conditional slide animation,
	  it reliably honours the setting on every build.
	-->

	<!-- ==================== BOTTOM BAR (default) ==================== -->
	<control type="group">
		<visible>!String.IsEqual(Skin.String(osd_position),top)</visible>

		<control type="image">
			<left>0</left>
			<bottom>0</bottom>
			<width>1920</width>
			<height>140</height>
			<texture colordiffuse="E0181C22">white.png</texture>
		</control>
		<!-- Accent stripe on the top edge (nearest the video above) -->
		<control type="image">
			<left>0</left>
			<bottom>138</bottom>
			<width>1920</width>
			<height>2</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<control type="label">
			<left>40</left>
			<bottom>0</bottom>
			<width>200</width>
			<height>140</height>
			<font>font_reg</font>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$INFO[Player.Time]</label>
		</control>

		<control type="progress">
			<left>260</left>
			<bottom>74</bottom>
			<width>1400</width>
			<height>6</height>
			<info>Player.ProgressCache</info>
			<texturebg>-</texturebg>
			<lefttexture colordiffuse="40FFFFFF">white.png</lefttexture>
			<midtexture colordiffuse="40FFFFFF">white.png</midtexture>
			<righttexture colordiffuse="40FFFFFF">white.png</righttexture>
			<overlaytexture>-</overlaytexture>
		</control>
		<control type="image">
			<left>260</left>
			<bottom>74</bottom>
			<width>1400</width>
			<height>6</height>
			<texture colordiffuse="40FFFFFF">white.png</texture>
		</control>
		<control type="progress" id="23">
			<left>260</left>
			<bottom>74</bottom>
			<width>1400</width>
			<height>6</height>
			<info>Player.Progress</info>
			<texturebg>-</texturebg>
			<lefttexture colordiffuse="accent_hi">white.png</lefttexture>
			<midtexture colordiffuse="accent_hi">white.png</midtexture>
			<righttexture colordiffuse="accent_hi">white.png</righttexture>
			<overlaytexture>-</overlaytexture>
		</control>

		<control type="label">
			<left>0</left>
			<bottom>92</bottom>
			<width>1920</width>
			<height>34</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>Seeking to $INFO[Player.SeekTime]</label>
			<visible>Player.Seeking | Player.HasPerformedSeek(3)</visible>
		</control>
		<control type="label">
			<left>0</left>
			<bottom>92</bottom>
			<width>1920</width>
			<height>34</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>Paused</label>
			<visible>Player.Paused + !Player.Seeking + !Player.HasPerformedSeek(3)</visible>
		</control>

		<control type="label">
			<left>260</left>
			<bottom>40</bottom>
			<width>1400</width>
			<height>30</height>
			<font>font_small</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>$INFO[Player.ChapterName]</label>
			<visible>!String.IsEmpty(Player.ChapterName)</visible>
		</control>

		<control type="label">
			<right>40</right>
			<bottom>0</bottom>
			<width>200</width>
			<height>140</height>
			<font>font_reg</font>
			<align>right</align>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$INFO[Player.Duration]</label>
		</control>
	</control>

	<!-- ==================== TOP BAR (osd_position=top) ==================== -->
	<control type="group">
		<visible>String.IsEqual(Skin.String(osd_position),top)</visible>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>140</height>
			<texture colordiffuse="E0181C22">white.png</texture>
		</control>
		<!-- Accent stripe on the bottom edge (nearest the video below) -->
		<control type="image">
			<left>0</left>
			<top>138</top>
			<width>1920</width>
			<height>2</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<control type="label">
			<left>40</left>
			<top>0</top>
			<width>200</width>
			<height>140</height>
			<font>font_reg</font>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$INFO[Player.Time]</label>
		</control>

		<control type="progress">
			<left>260</left>
			<top>60</top>
			<width>1400</width>
			<height>6</height>
			<info>Player.ProgressCache</info>
			<texturebg>-</texturebg>
			<lefttexture colordiffuse="40FFFFFF">white.png</lefttexture>
			<midtexture colordiffuse="40FFFFFF">white.png</midtexture>
			<righttexture colordiffuse="40FFFFFF">white.png</righttexture>
			<overlaytexture>-</overlaytexture>
		</control>
		<control type="image">
			<left>260</left>
			<top>60</top>
			<width>1400</width>
			<height>6</height>
			<texture colordiffuse="40FFFFFF">white.png</texture>
		</control>
		<control type="progress" id="23">
			<left>260</left>
			<top>60</top>
			<width>1400</width>
			<height>6</height>
			<info>Player.Progress</info>
			<texturebg>-</texturebg>
			<lefttexture colordiffuse="accent_hi">white.png</lefttexture>
			<midtexture colordiffuse="accent_hi">white.png</midtexture>
			<righttexture colordiffuse="accent_hi">white.png</righttexture>
			<overlaytexture>-</overlaytexture>
		</control>

		<control type="label">
			<left>0</left>
			<top>14</top>
			<width>1920</width>
			<height>34</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>Seeking to $INFO[Player.SeekTime]</label>
			<visible>Player.Seeking | Player.HasPerformedSeek(3)</visible>
		</control>
		<control type="label">
			<left>0</left>
			<top>14</top>
			<width>1920</width>
			<height>34</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>Paused</label>
			<visible>Player.Paused + !Player.Seeking + !Player.HasPerformedSeek(3)</visible>
		</control>

		<control type="label">
			<left>260</left>
			<top>70</top>
			<width>1400</width>
			<height>30</height>
			<font>font_small</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>$INFO[Player.ChapterName]</label>
			<visible>!String.IsEmpty(Player.ChapterName)</visible>
		</control>

		<control type="label">
			<right>40</right>
			<top>0</top>
			<width>200</width>
			<height>140</height>
			<font>font_reg</font>
			<align>right</align>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$INFO[Player.Duration]</label>
		</control>
	</control>

	</controls>
</window>
