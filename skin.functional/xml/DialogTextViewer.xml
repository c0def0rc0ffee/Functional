		</control>

		<control type="label" id="1">
			<left>0</left>
			<top>10</top>
			<width>1600</width>
			<height>60</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<control type="textbox" id="5">
			<left>40</left>
			<top>80</top>
			<width>1520</width>
			<height>800</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
		</control>

	</controls>
</window>
