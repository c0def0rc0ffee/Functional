<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">5</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>160</posx>
		<posy>80</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-160</left>
			<top>-80</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1600</width>
			<height>920</height>
