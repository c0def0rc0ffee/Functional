					<align>center</align>
					<aligny>center</aligny>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label>Bottom  +  10 px</label>
					<onclick>Skin.SetString(layout_command,bottom_inc)</onclick>
					<onfocus>Skin.SetBool(left_menu_open)</onfocus>
					<onright>51</onright>
					<onup>8503</onup>
					<ondown>8506</ondown>
				</control>

				<!-- Small-gallery column count toggle (11 vs 12).
				     Default unset = 12 (panel 1860 / 155). Set to 11 for
				     TVs with overscan where the rightmost tile is clipped. -->
				<control type="button" id="8506">
					<visible>Skin.HasSetting(layout_adjust)</visible>
					<width>380</width>
					<height>40</height>
					<font>font_small</font>
					<textcolor>text</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label>Small Cols: $VAR[SmallColsLabel]</label>
					<onclick condition="String.IsEqual(Skin.String(small_cols),11)">Skin.Reset(small_cols)</onclick>
					<onclick condition="!String.IsEqual(Skin.String(small_cols),11)">Skin.SetString(small_cols,11)</onclick>
					<onclick>Container.Refresh</onclick>
					<onfocus>Skin.SetBool(left_menu_open)</onfocus>
					<onright>51</onright>
					<onup>8505</onup>
					<ondown>8008</ondown>
				</control>

				<!-- Close -->
				<control type="button" id="8008">
					<width>380</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>left</align>
					<aligny>center</aligny>
					<textoffsetx>20</textoffsetx>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label>Close</label>
					<onclick>SetFocus(51)</onclick>
					<onfocus>Skin.SetBool(left_menu_open)</onfocus>
					<onright>51</onright>
					<onup>8506</onup>
					<ondown>8001</ondown>
				</control>

			</control>

		</control>

	</controls>
</window>
