			</control>
			<!-- Bottom-left: time-related metadata (anchored, doesn't jump) -->
			<control type="label">
				<left>40</left>
				<bottom>30</bottom>
				<width>800</width>
				<height>30</height>
				<font>font_reg</font>
				<textcolor>text_dim</textcolor>
				<label>$INFO[ListItem.Duration]$VAR[ItemEndsAtLabel]$VAR[ItemStarRatingLabel]</label>
			</control>

			<!-- Top-right: combined position/total -->
			<control type="label">
				<right>40</right>
				<bottom>72</bottom>
				<width>340</width>
				<height>40</height>
				<font>font_med</font>
				<textcolor>accent_hi</textcolor>
				<align>right</align>
				<label>$INFO[Container.CurrentItem] / $INFO[Container.NumItems] items</label>
			</control>
			<!-- Bottom-right: descriptive metadata, right-aligned so it grows leftward -->
