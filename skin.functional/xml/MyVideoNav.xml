<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
	<defaultcontrol always="true">51</defaultcontrol>
	<views>51,50</views>
	<!-- Seed the sort tracker on first load so the Sort dropdown
	     always has a radio selected. Calling SetSortMethod here also
	     guarantees the displayed selection matches the actual sort. -->
	<onload condition="String.IsEmpty(Skin.String(sort_active))">Skin.SetString(sort_active,title)</onload>
	<onload condition="String.IsEqual(Skin.String(sort_active),title)">Container.SetSortMethod(29)</onload>
	<!-- Start with the filter sub-menu collapsed (also tidies up after the
	     Local Only disable, which reloads this window via ReplaceWindow). -->
	<onload>Skin.Reset(filter_menu_open)</onload>
	<controls>

		<include content="WindowBackground"/>

		<!-- ========== FILTER DEBUG OVERLAY (visible when filter_debug is on) ========== -->
		<control type="group">
			<visible>Skin.HasSetting(filter_debug)</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>110</height>
				<texture colordiffuse="C0000000">white.png</texture>
			</control>
			<control type="label">
				<left>40</left>
				<top>10</top>
				<width>1840</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>$VAR[AccentColor]</textcolor>
				<label>FILTER DEBUG: Content / FolderPath / Items / IsFiltered</label>
			</control>
			<control type="label">
				<left>40</left>
				<top>40</top>
				<width>1840</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>white</textcolor>
				<label>Content: $INFO[Container.Content]    Items: $INFO[Container(51).NumItems]    Filtered: $VAR[DebugYesNoFiltered]    Updating: $VAR[DebugYesNoUpdating]</label>
			</control>
			<control type="label">
				<left>40</left>
				<top>70</top>
				<width>1840</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>text_dim</textcolor>
				<label>Path: $INFO[Container.FolderPath]</label>
			</control>
		</control>

		<!-- ========== GALLERY VIEW (id 51) ==========
		     Wrapped in a group whose vertical position is driven by 52
		     pre-baked conditional slide animations (one per discrete
		     clearance value). Animations on the GROUP move it without
		     touching the panel's own tile-layout maths inside, which
		     was the source of the spacing weirdness when the animations
		     were on the panel directly. -->
		<control type="group">
			<left>30</left>
			<top>0</top>
			<right>30</right>
			<bottom>0</bottom>
			<include content="ClearanceAnimations"/>
		<control type="panel" id="51">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<onleft>8001</onleft>
			<onright>51</onright>
			<onup>51</onup>
			<onfocus>Skin.Reset(left_menu_open)</onfocus>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<pagecontrol>60</pagecontrol>
			<viewtype label="Gallery">icon</viewtype>

			<!-- ===== GALLERY TILE SIZE VARIANTS =====
			     Two ratio modes:
			       * Tall (default): poster ~1:1.95, tile_h adds 8 px frame.
			         Helps absorb the cropping that aspectratio="scale" does
			         on near-2:3 art.
			       * Compact (Skin.HasSetting(compact_posters)): strict 2:3
			         (poster_h = poster_w * 1.5). Use on TVs whose overscan
			         clips the bottom of the taller boxes. -->

			<!-- ===== COMPACT (2:3) variants, listed first so they win when set ===== -->
			<itemlayout height="249" width="169" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),small) + String.IsEqual(Skin.String(small_cols),11)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="161"/>
					<param name="poster_h" value="241"/>
				</include>
			</itemlayout>
			<itemlayout height="228" width="155" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),small)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="147"/>
					<param name="poster_h" value="220"/>
				</include>
			</itemlayout>
			<itemlayout height="344" width="232" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),large)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="224"/>
					<param name="poster_h" value="336"/>
				</include>
			</itemlayout>
			<itemlayout height="461" width="310" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),xlarge)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="302"/>
					<param name="poster_h" value="453"/>
				</include>
			</itemlayout>
			<itemlayout height="305" width="206" condition="Skin.HasSetting(compact_posters)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="198"/>
					<param name="poster_h" value="297"/>
				</include>
			</itemlayout>

			<!-- ===== TALL (default) variants ===== -->
			<itemlayout height="312" width="169" condition="String.IsEqual(Skin.String(gallery_size),small) + String.IsEqual(Skin.String(small_cols),11)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="161"/>
					<param name="poster_h" value="304"/>
				</include>
			</itemlayout>
			<itemlayout height="312" width="155" condition="String.IsEqual(Skin.String(gallery_size),small)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="147"/>
					<param name="poster_h" value="304"/>
				</include>
			</itemlayout>
			<itemlayout height="494" width="232" condition="String.IsEqual(Skin.String(gallery_size),large)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="224"/>
					<param name="poster_h" value="486"/>
				</include>
			</itemlayout>
			<itemlayout height="585" width="310" condition="String.IsEqual(Skin.String(gallery_size),xlarge)">
				<include content="GalleryTileBody">
					<param name="poster_w" value="302"/>
					<param name="poster_h" value="577"/>
				</include>
			</itemlayout>
			<itemlayout height="403" width="206">
				<include content="GalleryTileBody">
					<param name="poster_w" value="198"/>
					<param name="poster_h" value="395"/>
				</include>
			</itemlayout>

			<!-- COMPACT focused variants -->
			<focusedlayout height="249" width="169" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),small) + String.IsEqual(Skin.String(small_cols),11)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="169"/>
					<param name="bg_h" value="249"/>
					<param name="poster_w" value="161"/>
					<param name="poster_h" value="241"/>
				</include>
			</focusedlayout>
			<focusedlayout height="228" width="155" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),small)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="155"/>
					<param name="bg_h" value="228"/>
					<param name="poster_w" value="147"/>
					<param name="poster_h" value="220"/>
				</include>
			</focusedlayout>
			<focusedlayout height="344" width="232" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),large)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="232"/>
					<param name="bg_h" value="344"/>
					<param name="poster_w" value="224"/>
					<param name="poster_h" value="336"/>
				</include>
			</focusedlayout>
			<focusedlayout height="461" width="310" condition="Skin.HasSetting(compact_posters) + String.IsEqual(Skin.String(gallery_size),xlarge)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="310"/>
					<param name="bg_h" value="461"/>
					<param name="poster_w" value="302"/>
					<param name="poster_h" value="453"/>
				</include>
			</focusedlayout>
			<focusedlayout height="305" width="206" condition="Skin.HasSetting(compact_posters)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="206"/>
					<param name="bg_h" value="305"/>
					<param name="poster_w" value="198"/>
					<param name="poster_h" value="297"/>
				</include>
			</focusedlayout>

			<!-- TALL focused variants -->
			<focusedlayout height="312" width="169" condition="String.IsEqual(Skin.String(gallery_size),small) + String.IsEqual(Skin.String(small_cols),11)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="169"/>
					<param name="bg_h" value="312"/>
					<param name="poster_w" value="161"/>
					<param name="poster_h" value="304"/>
				</include>
			</focusedlayout>
			<focusedlayout height="312" width="155" condition="String.IsEqual(Skin.String(gallery_size),small)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="155"/>
					<param name="bg_h" value="312"/>
					<param name="poster_w" value="147"/>
					<param name="poster_h" value="304"/>
				</include>
			</focusedlayout>
			<focusedlayout height="494" width="232" condition="String.IsEqual(Skin.String(gallery_size),large)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="232"/>
					<param name="bg_h" value="494"/>
					<param name="poster_w" value="224"/>
					<param name="poster_h" value="486"/>
				</include>
			</focusedlayout>
			<focusedlayout height="585" width="310" condition="String.IsEqual(Skin.String(gallery_size),xlarge)">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="310"/>
					<param name="bg_h" value="585"/>
					<param name="poster_w" value="302"/>
					<param name="poster_h" value="577"/>
				</include>
			</focusedlayout>
			<focusedlayout height="403" width="206">
				<include content="GalleryFocusedBody">
					<param name="tile_w" value="206"/>
					<param name="bg_h" value="403"/>
					<param name="poster_w" value="198"/>
					<param name="poster_h" value="395"/>
				</include>
			</focusedlayout>
		</control>
		</control>
		<!-- ========== /gallery wrapping group ========== -->

		<!-- ========== LIST VIEW (id 50) ========== -->
		<control type="group">
			<left>30</left>
			<top>0</top>
			<right>30</right>
			<bottom>0</bottom>
			<include content="ClearanceAnimations"/>
		<control type="list" id="50">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<onleft>8001</onleft>
			<onright>50</onright>
			<onfocus>Skin.Reset(left_menu_open)</onfocus>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<pagecontrol>60</pagecontrol>
			<viewtype label="List">list</viewtype>

			<itemlayout height="60" width="1860">
				<control type="image">
					<left>10</left>
					<top>5</top>
					<width>50</width>
					<height>50</height>
					<texture fallback="DefaultFolder.png">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>80</left>
					<top>0</top>
					<width>1500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>0</top>
					<width>240</width>
					<height>60</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>

			<focusedlayout height="60" width="1860">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1860</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
				</control>
				<control type="image">
					<left>10</left>
					<top>5</top>
					<width>50</width>
					<height>50</height>
					<texture fallback="DefaultFolder.png">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>80</left>
					<top>0</top>
					<width>1500</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>0</top>
					<width>240</width>
					<height>60</height>
					<font>font_small</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>
		</control>
		<!-- ========== /list wrapping group ========== -->

		<!-- Scrollbar, sits OUTSIDE the wrapping groups so it doesn't get
		     translated by the clearance animations. Static bounds: coordinate
		     tags can't read $INFO (they parse as 0), so this matches the
		     panels' effective area at the default 140px clearance; slight
		     visual offset at extreme clearance values is acceptable. -->
		<control type="scrollbar" id="60">
			<right>10</right>
			<top>140</top>
			<width>16</width>
			<bottom>140</bottom>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>50</onleft>
			<onright>50</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="accent_hi">white.png</texturesliderbarfocus>
		</control>

		<!-- ========== FAST-SCROLL LETTER BADGE ==========
		     A big letter of the focused item's sort position, shown while the
		     list is being flicked, so you can see roughly where you are. It
		     rides the right-hand end of the info bar and pops out of it: up
		     out of the top edge when the bar is at the bottom (default), and
		     down out of the bottom edge when the bar is at the top. Gated on
		     ListItem.SortLetter being non-empty so it only appears when the
		     current sort actually yields a letter/number. -->

		<!-- Bottom bar: badge pops UP from the bar's top edge, lower-right -->
		<control type="group">
			<visible>[Container(51).Scrolling | Container(50).Scrolling] + !String.IsEmpty(ListItem.SortLetter) + !Skin.HasSetting(infobar_top)</visible>
			<animation effect="fade" start="0" end="100" time="100">Visible</animation>
			<animation effect="fade" start="100" end="0" time="250">Hidden</animation>
			<control type="image">
				<right>50</right>
				<bottom>122</bottom>
				<width>150</width>
				<height>150</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>
			<control type="label">
				<right>50</right>
				<bottom>122</bottom>
				<width>150</width>
				<height>150</height>
				<font>font60</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[ListItem.SortLetter]</label>
			</control>
		</control>

		<!-- Top bar: badge hangs DOWN from the bar's bottom edge, upper-right -->
		<control type="group">
			<visible>[Container(51).Scrolling | Container(50).Scrolling] + !String.IsEmpty(ListItem.SortLetter) + Skin.HasSetting(infobar_top)</visible>
			<animation effect="fade" start="0" end="100" time="100">Visible</animation>
			<animation effect="fade" start="100" end="0" time="250">Hidden</animation>
			<control type="image">
				<right>50</right>
				<top>122</top>
				<width>150</width>
				<height>150</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>
			<control type="label">
				<right>50</right>
				<top>122</top>
				<width>150</width>
				<height>150</height>
				<font>font60</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[ListItem.SortLetter]</label>
			</control>
		</control>

		<!-- ========== INFO STRIP (BOTTOM, default) ========== -->
		<control type="group">
			<visible>!Skin.HasSetting(infobar_top)</visible>

			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>120</height>
				<texture colordiffuse="FF0F1217">white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<bottom>120</bottom>
				<width>1920</width>
				<height>2</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<control type="label">
				<left>40</left>
				<bottom>72</bottom>
				<width>1500</width>
				<height>40</height>
				<font>font_big</font>
				<textcolor>text</textcolor>
				<label>$INFO[ListItem.Label]$VAR[ItemTitleSuffix]</label>
