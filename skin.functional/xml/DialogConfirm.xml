<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
	<defaultcontrol always="true">10</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<depth>DepthDialog+</depth>
	<controls>

		<!-- Full-screen dim -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Centred panel: 900×440 -->
		<control type="group">
			<width>900</width>
			<height>440</height>
			<centertop>50%</centertop>
			<centerleft>50%</centerleft>

			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>900</width>
				<height>440</height>
				<texture colordiffuse="bg_panel">white.png</texture>
			</control>

			<!-- Accent strip -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>900</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<!-- Heading (id 1) -->
			<control type="label" id="1">
				<left>40</left>
				<top>20</top>
				<width>820</width>
				<height>60</height>
				<font>font_med</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>text</textcolor>
				<label></label>
			</control>

			<!-- Body (id 9) -->
			<control type="textbox" id="9">
				<left>40</left>
				<top>100</top>
				<width>820</width>
				<height>200</height>
				<font>font_reg</font>
				<align>center</align>
				<textcolor>text</textcolor>
				<label></label>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>

			<!-- Optional progress bar (id 20), used by some yesno calls -->
			<control type="progress" id="20">
				<left>40</left>
				<top>305</top>
				<width>820</width>
				<height>10</height>
				<info>System.Progressbar</info>
			</control>

			<!-- Action buttons. Kodi populates labels on 10 (No / OK), 11 (Yes), 12 (Cancel). -->
			<control type="grouplist" id="9000">
				<left>0</left>
				<top>340</top>
				<width>900</width>
				<height>80</height>
				<align>center</align>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>

				<control type="button" id="11">
					<width>260</width>
					<height>80</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>0</textoffsetx>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label></label>
				</control>
				<control type="button" id="10">
					<width>260</width>
					<height>80</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>0</textoffsetx>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label></label>
				</control>
				<control type="button" id="12">
					<width>260</width>
					<height>80</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>0</textoffsetx>
					<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
					<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
					<label></label>
				</control>

			</control>

		</control>

	</controls>
</window>
