<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
	<defaultcontrol>8</defaultcontrol>
	<controls>

		<!-- Video being calibrated, shown behind the UI during playback (per Estuary) -->
		<control type="videowindow" id="20">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<visible>Player.HasVideo</visible>
		</control>

		<!-- Solid backdrop so the markers are clearly visible (only when no video plays) -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="FF0F1217">white.png</texture>
			<visible>!Player.HasVideo</visible>
		</control>

		<!-- ===== MOVERS / RESIZERS ===== -->

		<!-- 8: Top-left mover, sets the visible-area top-left corner -->
		<control type="mover" id="8">
			<description>top left mover</description>
			<left>0</left>
			<top>0</top>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="$VAR[AccentColor]">calibrate/cal_tl.png</texturefocus>
			<texturenofocus colordiffuse="white">calibrate/cal_tl.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up" />
				<eventconfig type="down" />
				<eventconfig type="left" />
				<eventconfig type="right" />
			</movingspeed>
		</control>

		<!-- 9: Bottom-right mover, sets the visible-area bottom-right corner -->
		<control type="mover" id="9">
			<description>right bottom mover</description>
			<right>0</right>
			<bottom>0</bottom>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="$VAR[AccentColor]">calibrate/cal_br.png</texturefocus>
			<texturenofocus colordiffuse="white">calibrate/cal_br.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up" />
				<eventconfig type="down" />
				<eventconfig type="left" />
				<eventconfig type="right" />
			</movingspeed>
		</control>

		<!-- 10: Subtitle position mover, vertical placement only -->
		<control type="mover" id="10">
			<description>subtitle position mover</description>
			<left>770</left>
			<top>900</top>
			<width>380</width>
			<height>90</height>
			<!-- Image has 40px of transparency above and below the bar, per Estuary -->
			<texturefocus colordiffuse="$VAR[AccentColor]">calibrate/cal_sub.png</texturefocus>
			<texturenofocus colordiffuse="white">calibrate/cal_sub.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up" />
				<eventconfig type="down" />
			</movingspeed>
		</control>

		<!-- 11: Pixel aspect ratio resize control -->
		<control type="resize" id="11">
			<description>pixel aspect ratio</description>
			<left>710</left>
			<top>290</top>
			<width>500</width>
			<height>500</height>
			<texturefocus colordiffuse="$VAR[AccentColor]">calibrate/cal_ratio.png</texturefocus>
			<texturenofocus colordiffuse="white">calibrate/cal_ratio.png</texturenofocus>
			<movingspeed acceleration="140" maxvelocity="300" resettimeout="180" delta="1">
				<eventconfig type="left" />
				<eventconfig type="right" />
			</movingspeed>
		</control>

		<!-- 12: Reset calibration -->
		<control type="mover" id="12">
			<description>reset calibration</description>
			<left>40</left>
			<bottom>40</bottom>
			<width>100</width>
			<height>100</height>
			<texturefocus colordiffuse="$VAR[AccentColor]">calibrate/reset.png</texturefocus>
			<texturenofocus colordiffuse="white">calibrate/reset.png</texturenofocus>
		</control>

		<!-- ===== STATUS LABELS ===== -->

		<!-- Window title -->
		<control type="label">
			<left>0</left>
			<top>20</top>
			<width>1920</width>
			<height>50</height>
			<align>center</align>
			<font>font_med</font>
			<textcolor>text</textcolor>
			<shadowcolor>FF000000</shadowcolor>
			<label>$LOCALIZE[214]</label>
		</control>

		<!-- Resolution info (Kodi populates id 2) -->
		<control type="label" id="2">
			<left>0</left>
			<top>80</top>
			<width>1920</width>
			<height>40</height>
			<align>center</align>
			<font>font_reg</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<shadowcolor>FF000000</shadowcolor>
			<label></label>
		</control>

		<!-- Control description / help (Kodi populates id 3) -->
		<control type="label" id="3">
			<left>0</left>
			<top>130</top>
			<width>1920</width>
			<height>40</height>
			<align>center</align>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<shadowcolor>FF000000</shadowcolor>
			<label></label>
		</control>

		<!-- Calibration value (Kodi populates id 4) -->
		<control type="label" id="4">
			<left>0</left>
			<top>180</top>
			<width>1920</width>
			<height>40</height>
			<align>center</align>
			<font>font_med</font>
			<textcolor>accent_hi</textcolor>
			<shadowcolor>FF000000</shadowcolor>
			<label></label>
		</control>

	</controls>
</window>
