<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Add-on settings dialog. Kodi binds its category and setting lists into
  the fixed ids; this file supplies the frame, heading and action buttons.
  </summary>
-->
<window type="dialog">
	<defaultcontrol always="true">5</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>160</posx>
		<posy>80</posy>
	</coordinates>
	<controls>

		<!-- Dim backdrop -->
		<control type="image">
			<left>-160</left>
			<top>-80</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Panel -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1600</width>
			<height>920</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1600</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading (Kodi populates id=2) -->
		<control type="label" id="2">
			<left>0</left>
			<top>20</top>
			<width>1600</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<!-- LEFT: category buttons (Kodi clones button id=10) -->
		<control type="grouplist" id="3">
			<left>40</left>
			<top>90</top>
			<width>400</width>
			<!-- nine 70 px rows and eight 4 px gaps -->
			<height>662</height>
			<itemgap>4</itemgap>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>9000</onleft>
			<onright>5</onright>
			<onup>3</onup>
			<ondown>20</ondown>
		</control>

		<!-- Settings level toggle -->
		<control type="button" id="20">
			<left>40</left>
			<top>820</top>
			<width>400</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<onclick>SettingsLevelChange</onclick>
			<onleft>20</onleft>
			<onright>9000</onright>
			<onup>3</onup>
			<ondown>3</ondown>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

		<!-- RIGHT: settings controls grouplist (Kodi populates with cloned
		     templates). Height 710 is nine 70 px rows and eight 10 px gaps, so
		     no part row shows; the bottom row of the dialog sits at 820 to
		     leave 20 px under it. -->
		<control type="grouplist" id="5">
			<left>480</left>
			<top>90</top>
			<width>1080</width>
			<height>710</height>
			<itemgap>10</itemgap>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>60</onright>
			<onup>5</onup>
			<ondown>9000</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
		</control>

		<!-- Description textbox (starts right of the settings-level button 20) -->
		<control type="textbox" id="6">
			<left>460</left>
			<top>823</top>
			<width>700</width>
			<!-- two 27 px lines of font_small -->
			<height>54</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<align>justify</align>
			<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
		</control>

		<!-- Scrollbar -->
		<control type="scrollbar" id="60">
			<left>1568</left>
			<top>90</top>
			<width>16</width>
			<height>710</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>5</onleft>
			<onright>9000</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="$VAR[AccentHiColor]">white.png</texturesliderbarfocus>
		</control>

		<!-- Action buttons (OK / Cancel / Defaults) -->
		<control type="grouplist" id="9000">
			<left>1180</left>
			<top>820</top>
			<width>400</width>
			<height>60</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<align>right</align>
			<onleft>20</onleft>
			<onright>9000</onright>
			<onup>5</onup>
			<ondown>5</ondown>

			<control type="button" id="28">
				<width>120</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="29">
				<width>120</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="30">
				<width>140</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
		</control>

		<!-- ===== TEMPLATES (Kodi clones one of these per setting) ===== -->

		<!-- Category button (left list). Empty texturenofocus = no background
		     when unfocused (Kodi renders colordiffuse=00000000 as opaque white). -->
		<control type="button" id="10">
			<onleft>3</onleft>
			<width>400</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus />
		</control>

		<!-- Every setting control below carries <onleft>3</onleft> so left
	     returns to the category list on the left. Without it focus sits on
	     the individual control, not on group 5, and group 5's own onleft
	     never applies, so the only way back was down to the button bar
	     and up again. Spin controls and sliders are deliberately excluded:
	     left and right adjust their value. -->
		<!-- Default button setting -->
		<control type="button" id="7">
			<onleft>3</onleft>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

		<!-- Default radiobutton setting -->
		<control type="radiobutton" id="8">
			<onleft>3</onleft>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<textureradioonfocus colordiffuse="white">dot.png</textureradioonfocus>
			<textureradioonnofocus colordiffuse="$VAR[AccentColor]">dot.png</textureradioonnofocus>
			<textureradioofffocus colordiffuse="$VAR[AccentColor]">dot.png</textureradioofffocus>
			<textureradiooffnofocus colordiffuse="grey_mid">dot.png</textureradiooffnofocus>
		</control>

		<!-- Default spincontrolex setting. The arrow textures are stated here
		     because Defaults.xml is inert: without them the spinner drew no
		     arrows at all. Same set as SettingsCategory.xml. -->
		<control type="spincontrolex" id="9">
			<reverse>true</reverse>
			<textureup colordiffuse="text">icons/prev.png</textureup>
			<textureupfocus colordiffuse="white">icons/prev.png</textureupfocus>
			<texturedown colordiffuse="text">icons/next.png</texturedown>
			<texturedownfocus colordiffuse="white">icons/next.png</texturedownfocus>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

		<!-- Separator -->
		<control type="image" id="11">
			<width>1080</width>
			<height>2</height>
			<texture colordiffuse="grey_mid">white.png</texture>
		</control>

		<!-- Edit (text input) -->
		<control type="edit" id="12">
			<onleft>3</onleft>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

		<!-- Default sliderex setting. Bar and nib textures stated for the same
		     reason as the spinner: without them the slider was invisible and
		     nothing showed that Select had made it active. -->
		<control type="sliderex" id="13">
			<sliderwidth>360</sliderwidth>
			<sliderheight>20</sliderheight>
			<texturesliderbar colordiffuse="40FFFFFF">white.png</texturesliderbar>
			<textureslidernib colordiffuse="white">slider_nib.png</textureslidernib>
			<textureslidernibfocus colordiffuse="$VAR[AccentHiColor]">slider_nib.png</textureslidernibfocus>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

		<!-- Group label -->
		<control type="label" id="14">
			<onleft>3</onleft>
			<width>1080</width>
			<height>50</height>
			<font>font_med</font>
			<textcolor>$VAR[AccentHiColor]</textcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
		</control>

		<!-- Colour picker -->
		<control type="colorbutton" id="15">
			<!-- Colour swatch: Kodi tints this mask with the setting's colour.
			     Without a mask texture no swatch is drawn at all. -->
			<colorwidth>100</colorwidth>
			<colorheight>40</colorheight>
			<texturecolormask>white.png</texturecolormask>
			<texturecolordisabledmask colordiffuse="disabled">white.png</texturecolordisabledmask>
			<onleft>3</onleft>
			<width>1080</width>
			<height>70</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<disabledcolor>disabled</disabledcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
		</control>

	</controls>
</window>
