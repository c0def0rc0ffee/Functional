<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
	<defaultcontrol always="true">6</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>

		<!-- Fanart background dimmed -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0101418">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Album / artist art left -->
		<control type="image">
			<left>80</left>
			<top>80</top>
			<width>600</width>
			<height>600</height>
			<aspectratio>scale</aspectratio>
			<texture fallback="DefaultAlbumCover.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
		</control>

		<!-- Title -->
		<control type="label">
			<left>720</left>
			<top>80</top>
			<right>80</right>
			<height>60</height>
			<font>font_huge</font>
			<textcolor>text</textcolor>
			<label>$INFO[ListItem.Title]$INFO[ListItem.Album]</label>
			<scroll>true</scroll>
		</control>

		<control type="label">
			<left>720</left>
			<top>150</top>
			<right>80</right>
			<height>34</height>
			<font>font_med</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>$INFO[ListItem.Artist]$INFO[ListItem.AlbumArtist]</label>
		</control>

		<control type="label">
			<left>720</left>
			<top>200</top>
			<right>80</right>
			<height>30</height>
			<font>font_reg</font>
			<textcolor>text_dim</textcolor>
			<label>$INFO[ListItem.Year]$INFO[ListItem.Genre,  ·  ,]$INFO[ListItem.Duration,  ·  ,]</label>
		</control>

		<control type="label">
			<left>720</left>
			<top>240</top>
			<right>80</right>
			<height>34</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<label>★ $INFO[ListItem.Rating]$INFO[ListItem.UserRating,    ·  Your rating: ,]</label>
			<visible>!String.IsEmpty(ListItem.Rating) | !String.IsEmpty(ListItem.UserRating)</visible>
		</control>

		<!-- Description / review -->
		<control type="textbox">
			<left>720</left>
			<top>290</top>
			<right>80</right>
			<height>380</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<label>$INFO[ListItem.AlbumDescription]$INFO[ListItem.ArtistDescription]$INFO[ListItem.Comment]</label>
			<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
		</control>

		<!-- Action buttons -->
		<control type="grouplist" id="9000">
			<left>80</left>
			<bottom>40</bottom>
			<width>1760</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<align>center</align>

			<control type="button" id="6">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="8">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="9">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="10">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<control type="button" id="12">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>

		</control>

	</controls>
</window>
