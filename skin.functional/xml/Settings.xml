<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Top level Settings window: panel 9000 of the category tiles under the
  header bar.
  </summary>
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>

		<include content="WindowBackground"/>
		<include content="HeaderBar">
			<param name="title" value="$LOCALIZE[31218]"/>
		</include>

		<control type="panel" id="9000">
			<left>60</left>
			<top>140</top>
			<width>1800</width>
			<height>880</height>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<orientation>vertical</orientation>
			<itemlayout height="100" width="900">
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>880</width>
					<height>80</height>
					<texture colordiffuse="grey_mid">white.png</texture>
				</control>
				<control type="label">
					<left>40</left>
					<top>10</top>
					<width>820</width>
					<height>80</height>
					<font>font_med</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="100" width="900">
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>880</width>
					<height>80</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
				</control>
				<control type="label">
					<left>40</left>
					<top>10</top>
					<width>820</width>
					<height>80</height>
					<font>font_med</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>31226</label>
					<onclick>ActivateWindow(PlayerSettings)</onclick>
				</item>
				<item>
					<label>31227</label>
					<onclick>ActivateWindow(MediaSettings)</onclick>
				</item>
				<item>
					<label>31228</label>
					<onclick>ActivateWindow(PVRSettings)</onclick>
				</item>
				<item>
					<label>31229</label>
					<onclick>ActivateWindow(ServiceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[15016]</label>
					<visible>System.GetBool(gamesgeneral.enable)</visible>
					<onclick>ActivateWindow(GameSettings)</onclick>
				</item>
				<item>
					<label>31230</label>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
				</item>
				<item>
					<label>31231</label>
					<onclick>ActivateWindow(Profiles)</onclick>
				</item>
				<item>
					<label>31232</label>
					<onclick>ActivateWindow(SystemSettings)</onclick>
				</item>
				<item>
					<label>31233</label>
					<onclick>ActivateWindow(SystemInfo)</onclick>
				</item>
				<item>
					<label>31005</label>
					<onclick>ActivateWindow(AddonBrowser)</onclick>
				</item>
				<item>
					<label>31086</label>
					<onclick>ActivateWindow(FileManager)</onclick>
				</item>
				<item>
					<label>31085</label>
					<onclick>ActivateWindow(EventLog)</onclick>
				</item>
				<item>
					<label>31234</label>
					<onclick>ActivateWindow(SkinSettings)</onclick>
				</item>
			</content>
		</control>

	</controls>
</window>
