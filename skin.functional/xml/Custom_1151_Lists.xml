						<left>10</left>
						<top>0</top>
						<width>50</width>
						<height>70</height>
						<font>font_small</font>
						<textcolor>text_dim</textcolor>
						<selectedcolor>$VAR[AccentHiColor]</selectedcolor>
						<align>right</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.CurrentItem]</label>
					</control>
					<control type="image">
						<left>80</left>
						<top>5</top>
						<width>107</width>
						<height>60</height>
						<aspectratio>scale</aspectratio>
						<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>210</left>
						<top>4</top>
						<width>940</width>
						<height>36</height>
						<font>font_reg</font>
						<textcolor>text</textcolor>
						<selectedcolor>$VAR[AccentHiColor]</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>210</left>
						<top>38</top>
						<width>940</width>
						<height>28</height>
						<font>font_small</font>
						<textcolor>text_dim</textcolor>
						<selectedcolor>$VAR[AccentHiColor]</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>

				<focusedlayout height="70" width="1180">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>1180</width>
						<height>70</height>
						<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
						<visible>Control.HasFocus(51)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>1180</width>
						<height>70</height>
						<texture colordiffuse="40FFFFFF">white.png</texture>
						<visible>!Control.HasFocus(51)</visible>
					</control>
					<control type="label">
						<left>10</left>
						<top>0</top>
						<width>50</width>
						<height>70</height>
						<font>font_small</font>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<align>right</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.CurrentItem]</label>
					</control>
					<control type="image">
						<left>80</left>
						<top>5</top>
						<width>107</width>
						<height>60</height>
						<aspectratio>scale</aspectratio>
						<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>210</left>
						<top>4</top>
						<width>940</width>
						<height>36</height>
						<font>font_reg</font>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Skin.HasSetting(lists_quick_buttons) | !Control.HasFocus(51)</visible>
					</control>
					<control type="label">
						<left>210</left>
						<top>38</top>
						<width>940</width>
						<height>28</height>
						<font>font_small</font>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
						<visible>!Skin.HasSetting(lists_quick_buttons) | !Control.HasFocus(51)</visible>
					</control>
					<control type="label">
						<left>210</left>
						<top>4</top>
						<width>720</width>
						<height>36</height>
						<font>font_reg</font>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<visible>Skin.HasSetting(lists_quick_buttons) + Control.HasFocus(51)</visible>
					</control>
					<control type="label">
						<left>210</left>
						<top>38</top>
						<width>720</width>
						<height>28</height>
						<font>font_small</font>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label2]</label>
						<visible>Skin.HasSetting(lists_quick_buttons) + Control.HasFocus(51)</visible>
					</control>
					<!-- LISTS-QUICK: up, down and remove at the right end of the
					     focused row. Right steps along them, left steps back to
					     the row itself; the one picked is white, and OK acts on
					     it (Includes.xml, ListsItemRow). The labels stop short
					     of the buttons while the switch is on. -->
					<control type="group">
						<visible>Skin.HasSetting(lists_quick_buttons) + Control.HasFocus(51)</visible>
					<control type="image">
						<left>950</left>
						<top>5</top>
						<width>60</width>
						<height>60</height>
						<texture colordiffuse="white">white.png</texture>
						<visible>String.IsEqual(Window(home).Property(Lists.Quick),up)</visible>
					</control>
					<control type="image">
						<left>950</left>
						<top>5</top>
						<width>60</width>
						<height>60</height>
						<texture colordiffuse="40000000">white.png</texture>
						<visible>!String.IsEqual(Window(home).Property(Lists.Quick),up)</visible>
					</control>
					<control type="image">
						<left>960</left>
						<top>15</top>
						<width>40</width>
						<height>40</height>
						<texture colordiffuse="$VAR[AccentColor]">icons/list_up.png</texture>
						<visible>String.IsEqual(Window(home).Property(Lists.Quick),up)</visible>
