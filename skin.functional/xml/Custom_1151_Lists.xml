			<animation effect="slide" end="0,120" time="0" condition="Skin.HasSetting(lists_actions_top)">Conditional</animation>
			<visible>!String.IsEqual(Window(home).Property(Lists.Sel.Idx),0) + !String.IsEmpty(Window(home).Property(Lists.Sel.Name))</visible>

			<control type="label">
				<left>660</left>
				<top>110</top>
				<width>1200</width>
				<height>40</height>
				<font>font_small</font>
				<textcolor>text_dim</textcolor>
				<label>$INFO[Window(home).Property(Lists.Sel.Name)]  ·  $INFO[Window(home).Property(Lists.Sel.CountLabel)]$INFO[Window(home).Property(Lists.Sel.Duration),  ·  ]</label>
			</control>

			<control type="list" id="51">
				<left>660</left>
				<top>150</top>
				<width>1180</width>
				<height>770</height>
				<!-- LISTS-QUICK: with the switch on, left and right walk the
				     focused row's quick buttons (Window(home).Property(
				     Lists.Quick): empty for the row, then up, down, del)
				     before leaving the list. Each line's condition excludes
				     the others. -->
				<onleft condition="!Skin.HasSetting(lists_quick_buttons) | String.IsEmpty(Window(home).Property(Lists.Quick))">50</onleft>
				<onleft condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),up)">ClearProperty(Lists.Quick,home)</onleft>
				<onleft condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),down)">SetProperty(Lists.Quick,up,home)</onleft>
				<onleft condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),del)">SetProperty(Lists.Quick,down,home)</onleft>
				<onright condition="!Skin.HasSetting(lists_quick_buttons) | String.IsEqual(Window(home).Property(Lists.Quick),del)">60</onright>
				<onright condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),del)">ClearProperty(Lists.Quick,home)</onright>
				<onright condition="Skin.HasSetting(lists_quick_buttons) + String.IsEmpty(Window(home).Property(Lists.Quick))">SetProperty(Lists.Quick,up,home)</onright>
				<onright condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),up)">SetProperty(Lists.Quick,down,home)</onright>
				<onright condition="Skin.HasSetting(lists_quick_buttons) + String.IsEqual(Window(home).Property(Lists.Quick),down)">SetProperty(Lists.Quick,del,home)</onright>
				<!-- Leaving the column puts the pick back on the row. That
				     is done on each way out rather than in onunfocus: the
				     service's SetFocus after a move counts as an unfocus,
				     and the pick has to survive it so OK can be pressed
				     again to keep moving the same row. -->
				<ondown>ClearProperty(Lists.Quick,home)</ondown>
				<ondown>9000</ondown>
				<onup>ClearProperty(Lists.Quick,home)</onup>
				<onup>9000</onup>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="31014">list</viewtype>

				<itemlayout height="70" width="1180">
