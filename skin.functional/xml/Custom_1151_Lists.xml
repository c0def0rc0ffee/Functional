						<top>5</top>
						<width>60</width>
						<height>60</height>
						<texture colordiffuse="40000000">white.png</texture>
						<visible>!String.IsEqual(Window(home).Property(Lists.Quick),del)</visible>
					</control>
					<control type="image">
