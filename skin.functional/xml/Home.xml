			     the first condition that holds, so the tab entry comes first and
			     the old target stays as the fallback. -->
			<onup condition="Control.IsVisible(9211)">9211</onup>
			<onup condition="Control.IsVisible(9006)">9006</onup>
			<ondown>9100</ondown>

			<control type="button" id="9001">
