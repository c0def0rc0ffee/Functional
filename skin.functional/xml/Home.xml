			<right>60</right>
			<top>180</top>
			<width>310</width>

			<!-- MOVIES section -->
			<control type="group">
				<visible>!Skin.HasSetting(hide_movies_count)</visible>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>310</width>
				<height>40</height>
				<font>font_med</font>
				<textcolor>$VAR[AccentColor]</textcolor>
				<label>31087</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>44</top>
				<width>310</width>
				<height>2</height>
