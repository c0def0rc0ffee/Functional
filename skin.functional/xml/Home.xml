<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Home screen. Main menu grouplist 9000 with the library, weather, lists,
  add-ons, favourites and power entries, plus the clock, stats and the
  background slideshow, each switchable from Skin Settings.
  </summary>
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<!-- The Continue Watching pop-up never survives a Home visit. -->
	<onload>Skin.Reset(continue_open)</onload>
	<controls>

		<include content="WindowBackground"/>

