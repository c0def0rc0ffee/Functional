			<left>0</left>
			<top>480</top>
			<width>1920</width>
			<height>140</height>
			<itemgap>20</itemgap>
			<orientation>horizontal</orientation>
			<align>center</align>
			<!-- The Continue Watching tab (9210 bottom, 9211 top) sits on the
