				<top>60</top>
				<width>160</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>text_dim</textcolor>
				<label>31088</label>
			</control>
			<control type="label">
				<left>180</left>
				<top>60</top>
				<width>130</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<label>$INFO[Skin.String(stat_movies_total)]</label>
			</control>

			<control type="label">
				<left>0</left>
				<top>100</top>
				<width>160</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>text_dim</textcolor>
				<label>31089</label>
			</control>
			<control type="label">
				<left>180</left>
				<top>100</top>
				<width>130</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>$VAR[AccentColor]</textcolor>
				<label>$INFO[Skin.String(stat_movies_unwatched)]</label>
			</control>

			<control type="label">
				<left>0</left>
				<top>140</top>
				<width>160</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>text_dim</textcolor>
				<label>31080</label>
			</control>
			<control type="label">
				<left>180</left>
				<top>140</top>
				<width>130</width>
				<height>34</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
