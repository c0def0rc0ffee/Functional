		</control>

		<!-- Footer hint -->
		<control type="label">
			<left>60</left>
			<bottom>40</bottom>
			<width>1000</width>
			<height>40</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<label>$LOCALIZE[31097]$INFO[System.AddonVersion(skin.functional)]</label>
			<visible>!Skin.HasSetting(hide_version)</visible>
		</control>

		<!-- Continue Watching: in-progress movies and episodes, newest played
		     first, as a pop-up panel behind a small tab at one screen edge
		     chosen by Skin.String(continue_tab): bottom (the default), top,
		     left or right. The tab toggles Skin.HasSetting(continue_open) and
		     hands focus to the panel's first list; Back, or moving out of a
		     list, closes the panel again, and the window's onload resets it
		     so Home never reopens with the panel up. The panel is a band
		     holding two horizontal rows side by side (9201 movies, 9203
		     episodes), above a bottom tab or below a top one.

		     The lists are live library containers fed by the skin's
		     continue_movies.xsp and continue_episodes.xsp (a "mixed" smart
		     playlist returns nothing for video on Kodi 21, hence two), so
		     each row carries its database id: a click plays it through
		     Kodi, a mark or a finished playback drops the row within a
		     second through Kodi's own library events (the content URL is
		     read once at load, so it must not carry $INFO), and a press
		     and hold opens Kodi's context menu, where
		     DialogContextMenu swaps in the skin's own Resume / Mark as
		     watched / Mark as unwatched rows while Window(home).Property(
		     continue_focus) says one of these lists has focus (published by
		     service.py:update_continue_watching). The closed panel sits off
		     screen rather than hidden, so its lists are already filled when
		     the tab is clicked and the click can focus one. hide_continue
		     (Home Screen) removes tab and panel together. Drawn after the menu, stats and icons so it sits
		     over them. -->
		<control type="group" id="9200">
			<visible allowhiddenfocus="true">!Skin.HasSetting(hide_continue)</visible>
			<!-- Closed means parked off screen, not hidden: Kodi applies a
			     library change to a container only while it processes it,
			     and it does not process a hidden group. Parked, the lists are
			     already full when the tab is clicked (so the click can focus
			     one) and they drop a marked or finished row while closed. -->
			<animation effect="slide" end="0,3000" time="0" condition="!Skin.HasSetting(continue_open)">Conditional</animation>
			<animation effect="fade" time="200">VisibleChange</animation>

			<!-- The band: above the bottom tab, or slid up below the top one -->
			<control type="group">
				<animation effect="slide" end="0,-640" time="0" condition="String.IsEqual(Skin.String(continue_tab),top)">Conditional</animation>
				<control type="image">
					<left>0</left>
					<top>676</top>
					<width>1920</width>
					<height>368</height>
					<texture colordiffuse="F4181C22">white.png</texture>
				</control>
				<control type="label">
					<left>60</left>
					<top>688</top>
					<width>600</width>
					<height>34</height>
					<font>font_med</font>
					<textcolor>$VAR[AccentColor]</textcolor>
					<label>31385</label>
				</control>
				<control type="label">
					<left>60</left>
					<top>726</top>
					<width>500</width>
					<height>24</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<label>31087</label>
				</control>
				<control type="label">
					<left>960</left>
					<top>726</top>
					<width>500</width>
					<height>24</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<label>31392</label>
				</control>

				<control type="list" id="9201">
					<visible allowhiddenfocus="true">true</visible>
					<left>60</left>
					<top>756</top>
					<width>900</width>
					<height>270</height>
					<orientation>horizontal</orientation>
					<onup>Skin.Reset(continue_open)</onup>
					<onup condition="String.IsEqual(Skin.String(continue_tab),top)">9211</onup>
					<onup condition="!String.IsEqual(Skin.String(continue_tab),top)">9210</onup>
					<ondown>Skin.Reset(continue_open)</ondown>
					<ondown condition="String.IsEqual(Skin.String(continue_tab),top)">9211</ondown>
