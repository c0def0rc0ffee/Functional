				<label>31090</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>264</top>
				<width>310</width>
				<height>2</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<control type="label">
