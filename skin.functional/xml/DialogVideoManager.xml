<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Kodi 21's Manage versions and Manage extras dialogs (one file serves
  both window ids): heading 2, the item's poster, the versions or extras in
  list 50 with scrollbar 60, and the action buttons in grouplist 101 on
  Kodi's ids (21 Play, 22 Add version, 23 Add extra, 27 Choose art, 24
  Choose type, 28 Rename, 26 Remove, 25 Set as default), each shown for
  the window it belongs to. Ids from Estuary; styling this skin's.
  </summary>
-->
<window type="dialog">
	<defaultcontrol always="true">50</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>140</posx>
		<posy>150</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-140</left>
			<top>-150</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="80000000">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1640</width>
			<height>780</height>
			<texture colordiffuse="FF181C22">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1640</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<bottom>0</bottom>
			<width>1640</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading (id 2), Kodi writes the title -->
		<control type="label" id="2">
			<left>0</left>
			<top>20</top>
			<width>1640</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<control type="image">
			<left>20</left>
			<top>90</top>
			<width>400</width>
			<height>600</height>
			<aspectratio aligny="top">keep</aspectratio>
			<texture fallback="DefaultVideoCover.png" background="true">$INFO[Container(50).ListItem.Art(poster)]</texture>
		</control>

		<control type="list" id="50">
			<left>440</left>
			<top>90</top>
			<width>860</width>
			<height>600</height>
			<onleft>101</onleft>
			<onright>60</onright>
			<onup>50</onup>
			<ondown>50</ondown>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout height="70" width="860">
				<control type="label">
					<left>20</left>
					<top>4</top>
					<width>820</width>
					<height>36</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>$VAR[AccentHiColor]</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>20</left>
					<top>38</top>
					<width>820</width>
					<height>28</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<selectedcolor>$VAR[AccentHiColor]</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout height="70" width="860">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>860</width>
					<height>70</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(50)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>4</top>
					<width>820</width>
					<height>36</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>20</left>
					<top>38</top>
					<width>820</width>
					<height>28</height>
					<font>font_small</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>

		<control type="scrollbar" id="60">
			<left>1310</left>
			<top>90</top>
			<width>12</width>
			<height>600</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>50</onleft>
			<onright>101</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="$VAR[AccentHiColor]">white.png</texturesliderbarfocus>
		</control>

		<control type="grouplist" id="101">
			<left>1340</left>
			<top>90</top>
			<width>280</width>
			<height>600</height>
			<orientation>vertical</orientation>
			<itemgap>10</itemgap>
			<onleft>50</onleft>
			<onright>50</onright>
			<control type="button" id="21">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[208]</label>
			</control>
			<control type="button" id="22">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[40014]</label>
				<visible>Window.IsVisible(managevideoversions)</visible>
			</control>
