				<visible>Window.IsVisible(managevideoextras)</visible>
			</control>
			<control type="button" id="26">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
