				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[40023]</label>
				<visible>Window.IsVisible(managevideoversions)</visible>
			</control>
		</control>

		<control type="label">
			<left>20</left>
			<bottom>12</bottom>
			<width>1600</width>
			<height>30</height>
			<font>font_small</font>
			<align>left</align>
			<textcolor>text_dim</textcolor>
			<label>$INFO[Container(50).ListItem.FileNameAndPath]</label>
		</control>

	</controls>
</window>
