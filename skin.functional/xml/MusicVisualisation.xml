<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Full screen music visualisation: visualisation control 2 filling the
  screen, with overlays not allowed. The artist and title line hides
  while the music OSD or the seek bar is up.
  </summary>
-->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<allowoverlay>no</allowoverlay>
	<controls>
		<control type="visualisation" id="2">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
		</control>
		<control type="label">
			<left>40</left>
			<bottom>40</bottom>
			<width>1840</width>
			<height>60</height>
			<font>font_big</font>
			<textcolor>text</textcolor>
			<label>$INFO[MusicPlayer.Artist,, · ]$INFO[MusicPlayer.Title]</label>
			<!-- The music OSD and the seek bar both draw a slightly see
			     through panel over this strip of the screen, and this line
			     showed through them as a ghost behind their own text. Both
			     name the track themselves, so it stands down for them. -->
			<visible>!Window.IsActive(musicosd) + !Window.IsVisible(seekbar)</visible>
		</control>
	</controls>
</window>
