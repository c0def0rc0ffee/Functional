<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  System Info window (id 7).

  Category buttons MUST use the hardcoded IDs Kodi expects:
    95 = Summary (default focus)
    94 = Storage
    96 = Network
    97 = Video
    98 = Hardware
    99 = PVR
   100 = Privacy policy (uses textbox 30)
   101 = Thank you (uses group 102)

  Info content slots:
    label  ids 2..13  -> Kodi fills each line based on focused category
    textbox id 30     -> long-form text (privacy policy)
    group   id 102    -> donate / thank-you panel
-->
<window>
	<defaultcontrol always="true">95</defaultcontrol>
