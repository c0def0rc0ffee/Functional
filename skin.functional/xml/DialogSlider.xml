<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">11</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>560</posx>
		<posy>440</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-560</left>
			<top>-440</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="26000000">white.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>800</width>
			<height>200</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>800</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading -->
		<control type="label" id="10">
			<left>40</left>
			<top>20</top>
			<width>720</width>
			<height>40</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<!-- Current value label -->
		<control type="label" id="12">
			<left>40</left>
			<top>70</top>
			<width>720</width>
			<height>34</height>
			<font>font_reg</font>
			<align>center</align>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label></label>
		</control>

		<!-- Slider -->
		<control type="slider" id="11">
			<left>80</left>
			<top>120</top>
			<width>640</width>
			<height>28</height>
			<orientation>horizontal</orientation>
			<texturesliderbar colordiffuse="grey_mid">white.png</texturesliderbar>
			<textureslidernib colordiffuse="white">slider_nib.png</textureslidernib>
			<textureslidernibfocus colordiffuse="accent_hi">slider_nib.png</textureslidernibfocus>
		</control>

	</controls>
</window>
