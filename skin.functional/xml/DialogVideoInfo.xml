<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
	<defaultcontrol always="true">6</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>

		<!-- Fanart background dimmed -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0101418">white.png</texture>
		</control>

		<!-- Top accent stripe -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Poster left -->
		<control type="image">
			<left>80</left>
			<top>80</top>
			<width>500</width>
			<height>750</height>
			<aspectratio>scale</aspectratio>
			<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Art(poster)]</texture>
		</control>

		<!-- Title and meta right -->
		<control type="label">
			<left>620</left>
			<top>80</top>
			<right>80</right>
			<height>60</height>
			<font>font_huge</font>
			<textcolor>text</textcolor>
			<label>$INFO[ListItem.Title]</label>
			<scroll>true</scroll>
		</control>

		<control type="label">
			<left>620</left>
			<top>150</top>
			<right>80</right>
			<height>30</height>
			<font>font_reg</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>$INFO[ListItem.TVShowTitle]$INFO[ListItem.Season,  ·  S,]$INFO[ListItem.Episode,E,]</label>
			<visible>!String.IsEmpty(ListItem.TVShowTitle)</visible>
		</control>

		<control type="label">
			<left>620</left>
			<top>190</top>
			<right>80</right>
			<height>34</height>
			<font>font_reg</font>
			<textcolor>text_dim</textcolor>
			<label>$VAR[InfoDateLabel]$INFO[ListItem.Genre,  ·  ,]$INFO[ListItem.Duration,  ·  ,m]$INFO[ListItem.MPAA,  ·  ,]</label>
		</control>

		<control type="label">
			<left>620</left>
			<top>234</top>
			<right>80</right>
			<height>34</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<label>★ $INFO[ListItem.Rating]$INFO[ListItem.Votes,   (,)]$INFO[ListItem.UserRating,    ·  Your rating: ,]</label>
			<visible>!String.IsEmpty(ListItem.Rating)</visible>
		</control>

		<!-- Tagline -->
		<control type="label">
			<left>620</left>
			<top>284</top>
			<right>80</right>
			<height>30</height>
			<font>font_reg</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>$INFO[ListItem.Tagline]</label>
			<scroll>true</scroll>
			<visible>!String.IsEmpty(ListItem.Tagline)</visible>
		</control>

		<!-- Plot -->
		<control type="textbox">
			<left>620</left>
			<top>330</top>
			<right>80</right>
			<height>360</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<label>$INFO[ListItem.Plot]</label>
			<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
		</control>

		<!-- Director / Writer -->
		<control type="label">
			<left>620</left>
			<top>700</top>
			<right>80</right>
			<height>30</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<label>$INFO[ListItem.Director,Directed by ,]</label>
			<visible>!String.IsEmpty(ListItem.Director)</visible>
		</control>
		<control type="label">
			<left>620</left>
			<top>734</top>
			<right>80</right>
			<height>30</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<label>$INFO[ListItem.Writer,Written by ,]</label>
			<visible>!String.IsEmpty(ListItem.Writer)</visible>
		</control>
		<control type="label">
			<left>620</left>
			<top>768</top>
			<right>80</right>
			<height>30</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<label>Cast: $INFO[ListItem.Cast]</label>
			<scroll>true</scroll>
			<visible>!String.IsEmpty(ListItem.Cast)</visible>
		</control>

		<!-- Watched indicator -->
		<control type="label">
			<right>80</right>
			<top>80</top>
			<width>200</width>
			<height>40</height>
			<font>font_reg</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<align>right</align>
			<label>✓ Watched</label>
			<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
		</control>

		<!-- Action buttons row -->
		<control type="grouplist" id="9000">
			<left>80</left>
			<bottom>40</bottom>
			<width>1760</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<align>center</align>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup>9000</onup>
			<ondown>9000</ondown>

			<!-- 6 = Play -->
			<control type="button" id="6">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 7 = Resume -->
			<control type="button" id="7">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 11 = Toggle watched -->
			<control type="button" id="11">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 5 = Cast / Similar -->
			<control type="button" id="5">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 8 = Refresh / Get info -->
			<control type="button" id="8">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 10 = Trailer -->
			<control type="button" id="10">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 12 = User rating -->
			<control type="button" id="12">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>
			<!-- 9 = Get thumb -->
			<control type="button" id="9">
				<width>200</width>
				<height>70</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			</control>

		</control>

	</controls>
</window>
