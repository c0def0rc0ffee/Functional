<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Full screen video window: the videowindow control plus the group 0
  overlays Kodi fills with codec and seek information. No default control.
  </summary>
-->
<window>
	<defaultcontrol></defaultcontrol>
	<allowoverlay>no</allowoverlay>
	<controls>
		<control type="videowindow">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
		</control>

		<!-- Kodi writes view-mode / zoom / codec feedback into labels 10-12
		     (group 0) and toggles their visibility itself. Without them,
		     cycling the view mode gives no on-screen response. -->
		<control type="group" id="0">
			<control type="label" id="10">
				<left>45</left>
				<top>15</top>
				<width>1830</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>white</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label></label>
			</control>
			<control type="label" id="11">
				<left>45</left>
				<top>45</top>
				<width>1830</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>white</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label></label>
			</control>
			<control type="label" id="12">
				<left>45</left>
				<top>75</top>
				<width>1830</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>white</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label></label>
			</control>
		</control>

		<!-- Buffering indicator: the only mid-playback rebuffer feedback in
		     Kodi. Without it a stalling stream is just frozen video.

		     It used to need a cache level above 0, which hid it at the very
		     moment a stall begins (the buffer is empty: that is the stall)
		     and for the whole of any stall under full file buffering, where
		     Player.CacheLevel stays at 0 because there is no fixed buffer to
		     be a percentage of. It now also shows at level 0 once playback
		     has got going. The Player.Time test is what still keeps it away
		     from the ordinary spin up at the start of a file; Integer
		     comparisons read a clock value as seconds. With no level to
		     report the figure and the bar stand down and the word is left on
		     its own. -->
		<control type="group" id="1">
			<visible>Player.Caching + [Integer.IsGreater(Player.CacheLevel,0) | Integer.IsGreater(Player.Time,0)]</visible>
			<animation effect="fade" delay="300" time="200">Visible</animation>
			<animation effect="fade" delay="200" time="150">Hidden</animation>
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>360</width>
			<height>110</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>360</width>
				<height>110</height>
				<texture colordiffuse="bg_panel">white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>360</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>10</top>
				<width>360</width>
				<height>40</height>
				<font>font_reg</font>
				<align>center</align>
				<textcolor>text</textcolor>
				<label>$LOCALIZE[31327] $INFO[Player.CacheLevel]%</label>
				<visible>Integer.IsGreater(Player.CacheLevel,0)</visible>
			</control>
			<control type="label">
				<left>0</left>
				<top>10</top>
				<width>360</width>
				<height>40</height>
				<font>font_reg</font>
				<align>center</align>
				<textcolor>text</textcolor>
				<label>$LOCALIZE[31327]</label>
				<visible>!Integer.IsGreater(Player.CacheLevel,0)</visible>
			</control>
			<control type="progress">
				<visible>Integer.IsGreater(Player.CacheLevel,0)</visible>
				<left>40</left>
				<top>70</top>
				<width>280</width>
				<height>6</height>
				<info>Player.CacheLevel</info>
				<texturebg colordiffuse="grey_mid">white.png</texturebg>
				<midtexture colordiffuse="$VAR[AccentColor]">white.png</midtexture>
				<overlaytexture>-</overlaytexture>
			</control>
		</control>
	</controls>
</window>
