<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol>10</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>360</posx>
		<posy>165</posy>
	</coordinates>
	<controls>

		<!-- Dim backdrop -->
		<control type="image">
			<left>-360</left>
			<top>-165</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Panel -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>750</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading (Kodi populates id=2 with Add/Edit media source) -->
		<control type="label" id="2">
			<left>0</left>
			<top>20</top>
			<width>1200</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<!-- Path hint -->
		<control type="label">
			<left>40</left>
			<top>74</top>
			<width>1120</width>
			<height>30</height>
			<font>font_small</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>$LOCALIZE[1021]</label>
		</control>

		<!-- Paths list (id 10), flat backing so the empty list reads as a field -->
		<control type="image">
			<left>40</left>
			<top>120</top>
			<width>780</width>
			<height>300</height>
			<texture colordiffuse="grey_dark">white.png</texture>
		</control>
		<control type="list" id="10">
			<left>40</left>
			<top>120</top>
			<width>780</width>
			<height>300</height>
			<onleft>9000</onleft>
			<onright>60</onright>
			<onup>9001</onup>
			<ondown>12</ondown>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>

			<itemlayout height="60" width="780">
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>740</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="780">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>780</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(10)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>740</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- Scrollbar -->
		<control type="scrollbar" id="60">
			<left>830</left>
			<top>120</top>
			<width>16</width>
			<height>300</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>10</onleft>
			<onright>9000</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="accent_hi">white.png</texturesliderbarfocus>
		</control>

		<!-- Path actions: 11 = browse, 13 = add, 14 = remove -->
		<control type="grouplist" id="9000">
			<left>880</left>
			<top>120</top>
			<width>280</width>
			<height>300</height>
			<orientation>vertical</orientation>
			<itemgap>10</itemgap>
			<onleft>10</onleft>
			<onright>10</onright>
			<onup>12</onup>
			<ondown>12</ondown>

			<control type="button" id="11">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[1024]</label>
			</control>
			<control type="button" id="13">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[15019]</label>
			</control>
			<control type="button" id="14">
				<width>280</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[1210]</label>
			</control>
		</control>

		<!-- Name -->
		<control type="label">
			<left>40</left>
			<top>460</top>
			<width>1120</width>
			<height>30</height>
			<font>font_small</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>$LOCALIZE[1022]</label>
		</control>
		<control type="edit" id="12">
			<left>40</left>
			<top>500</top>
			<width>1120</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<onup>10</onup>
			<ondown>9001</ondown>
		</control>

		<!-- Action buttons: 18 = OK, 19 = cancel -->
		<control type="grouplist" id="9001">
			<left>40</left>
			<top>660</top>
			<width>1120</width>
			<height>60</height>
			<orientation>horizontal</orientation>
			<itemgap>20</itemgap>
			<align>center</align>
			<onup>12</onup>
			<ondown>10</ondown>

			<control type="button" id="18">
				<width>240</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[186]</label>
			</control>
			<control type="button" id="19">
				<width>240</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[222]</label>
			</control>
		</control>

	</controls>
</window>
