<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Full screen info card, shown on the info key during playback: an
  overlay above the OSD with the playing item's details and cast, built
  from the FsInfoCardBody include. Button 999 takes default focus.
  </summary>
  <remarks>
  Item 19 (07/11/2026): it can close itself after a chosen number of
  seconds, and FsInfoCardBody can show a film's logo in place of its title.
  Both are off by default.
  </remarks>
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<!-- INFO-AUTO-CLOSE, item 19 (07/11/2026)
	     <summary>
	     Closes the card by itself after the seconds chosen in Skin Settings
	     (Playback, Close Info Panel After); Off, the default, leaves it open
	     until it is closed, as before.
	     </summary>
	     <remarks>
	     The time goes to the alarm as 00:SS, minutes and seconds, as
	     Startup.xml does with 0:01; a bare number would be taken as
	     minutes. The values are stored two digits wide (05, 10, 20, 30)
	     only so they read alike. Closing the card any other way cancels the
	     alarm, so a card opened again starts its own count and is never
	     shut early by the last one's.
	     </remarks> -->
	<onload condition="!String.IsEmpty(Skin.String(fsinfo_close))">AlarmClock(fsinfo_close,Dialog.Close(fullscreeninfo),00:$INFO[Skin.String(fsinfo_close)],silent)</onload>
	<onunload>CancelAlarm(fsinfo_close,true)</onunload>
	<animation effect="fade" time="200" condition="!Skin.HasSetting(reduce_motion)">WindowOpen</animation>
	<animation effect="fade" time="200" condition="!Skin.HasSetting(reduce_motion)">WindowClose</animation>
	<controls>

		<!-- Click-trap behind the card so the video keeps receiving seek/skip keys
		     and a click outside the card closes the dialog -->
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<disabledcolor>disabled</disabledcolor>
			<texturefocus />
			<texturenofocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>Info</onclick>
		</control>

		<!-- Subtle dim across the whole screen so card text reads cleanly -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="60000000">white.png</texture>
		</control>

		<!-- ===== INFO CARD, short form: 1400 × 540, centred =====
		     Used when service.py found no cast for the playing item. -->
		<control type="group">
			<centertop>50%</centertop>
			<centerleft>50%</centerleft>
			<width>1400</width>
			<height>540</height>
			<visible>String.IsEmpty(Window(home).Property(Cast.1.Name))</visible>

			<!-- Card background -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1400</width>
				<height>540</height>
				<texture colordiffuse="EE181C22">white.png</texture>
			</control>
			<!-- Top accent stripe -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1400</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<include content="FsInfoCardBody" />
		</control>

		<!-- ===== INFO CARD, tall form: 1400 × 780, centred =====
		     Same body plus a strip of cast portraits under the plot. -->
		<control type="group">
			<centertop>50%</centertop>
			<centerleft>50%</centerleft>
			<width>1400</width>
			<height>780</height>
			<visible>!String.IsEmpty(Window(home).Property(Cast.1.Name))</visible>

			<!-- Card background -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1400</width>
				<height>780</height>
				<texture colordiffuse="EE181C22">white.png</texture>
			</control>
			<!-- Top accent stripe -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1400</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<include content="FsInfoCardBody" />

			<!-- Hairline separating the blurb from the cast -->
			<control type="image">
				<left>30</left>
				<top>528</top>
				<width>1340</width>
				<height>1</height>
				<texture colordiffuse="40FFFFFF">white.png</texture>
			</control>

			<include content="FsInfoCastStrip" />
		</control>

	</controls>
</window>
