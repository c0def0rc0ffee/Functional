<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Volume pop-up (VOLUME-RING): a large ring in the middle of the screen
  with the volume percent at its centre. The ring's accent arc fills
  clockwise from twelve o'clock as the volume rises.
  </summary>
  <remarks>
  Kodi has no circular progress control, so the arc is one of 101 frames
  (media/volume/ring_000.png to ring_100.png, drawn by build_ui_icons.py)
  chosen by the VolumeRingFrame variable, and the number comes from
  VolumePercent, both in Includes.xml. Kodi fills in nothing on this
  dialog, every control is bound by the skin. While muted the arc dims
  and the centre reads Muted.
  </remarks>
-->
<window type="dialog">
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>780</posx>
		<posy>360</posy>
	</coordinates>
	<controls>

		<!-- Backing disc, then the grey track the arc runs along -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>360</width>
			<height>360</height>
			<texture colordiffuse="bg_dialog">volume/disc.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>360</width>
			<height>360</height>
			<texture colordiffuse="grey_mid">volume/track.png</texture>
		</control>

		<!-- The fill -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>360</width>
			<height>360</height>
			<texture colordiffuse="$VAR[AccentColor]">$VAR[VolumeRingFrame]</texture>
			<visible>!Player.Muted</visible>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>360</width>
			<height>360</height>
			<texture colordiffuse="disabled">$VAR[VolumeRingFrame]</texture>
			<visible>Player.Muted</visible>
		</control>

		<!-- Percent, with Volume under it, or Muted on its own -->
		<control type="label">
			<left>40</left>
			<top>110</top>
			<width>280</width>
			<height>110</height>
			<font>font60</font>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>white</textcolor>
			<label>$VAR[VolumePercent]%</label>
			<visible>!Player.Muted</visible>
		</control>
		<control type="label">
			<left>40</left>
			<top>220</top>
			<width>280</width>
			<height>40</height>
			<font>font_reg</font>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>text_dim</textcolor>
			<label>31081</label>
			<visible>!Player.Muted</visible>
		</control>
		<control type="label">
			<left>40</left>
			<top>125</top>
			<width>280</width>
			<height>110</height>
			<font>font_big</font>
			<align>center</align>
			<aligny>center</aligny>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>31082</label>
			<visible>Player.Muted</visible>
		</control>

	</controls>
</window>
