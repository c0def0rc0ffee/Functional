<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Volume popup: Kodi's slider 12 in a small panel that fades in on a
  volume change.
  </summary>
-->
<window type="dialog">
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<!-- A toast in one of the bottom positions (the default bottom right, bl
	     or bc) reaches into this 660..1260 by 900..1000 box, so the pop-up
	     steps up 160 px while one is showing. -->
	<animation effect="slide" end="0,-160" time="150" condition="Window.IsVisible(notification) + !String.IsEqual(Skin.String(notification_position),tl) + !String.IsEqual(Skin.String(notification_position),tc) + !String.IsEqual(Skin.String(notification_position),tr)">Conditional</animation>
	<coordinates>
		<system>1</system>
		<posx>660</posx>
		<posy>900</posy>
	</coordinates>
	<controls>

		<!-- Panel -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>100</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>
		<!-- Top accent stripe -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>3</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading: shows "Volume" or "Muted" -->
		<control type="label">
			<left>20</left>
			<top>0</top>
			<width>140</width>
			<height>100</height>
			<font>font_reg</font>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>31081</label>
			<visible>!Player.Muted</visible>
		</control>
		<control type="label">
			<left>20</left>
			<top>0</top>
			<width>140</width>
			<height>100</height>
			<font>font_reg</font>
			<aligny>center</aligny>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>31082</label>
			<visible>Player.Muted</visible>
		</control>

		<!-- Slider (id 12): the dialog code populates nothing, the skin must
		     bind the position to Player.Volume itself (Estuary does the same
		     with a Player.Volume-bound progress control) -->
		<control type="slider" id="12">
			<left>160</left>
			<top>40</top>
			<width>300</width>
			<height>20</height>
			<orientation>horizontal</orientation>
			<info>Player.Volume</info>
			<texturesliderbar colordiffuse="grey_mid">white.png</texturesliderbar>
			<textureslidernib colordiffuse="white">slider_nib.png</textureslidernib>
			<textureslidernibfocus colordiffuse="$VAR[AccentHiColor]">slider_nib.png</textureslidernibfocus>
		</control>

		<!-- Numeric readout (Kodi reports Player.Volume as dB, e.g. "-6.0 dB").
		     left 460 = 600 panel width less the 20 margin and the 120 width; a
		     root level <right> is measured from the 1920 canvas and put this
		     label off the screen. -->
		<control type="label">
			<left>460</left>
			<top>0</top>
			<width>120</width>
			<height>100</height>
			<font>font_reg</font>
			<align>right</align>
			<aligny>center</aligny>
			<textcolor>text</textcolor>
			<label>$INFO[Player.Volume]</label>
		</control>

	</controls>
</window>
