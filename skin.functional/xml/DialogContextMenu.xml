<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">996</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>660</posx>
		<posy>140</posy>
	</coordinates>
	<controls>

		<!-- Dim full-screen backdrop -->
		<control type="image">
			<left>-660</left>
			<top>-140</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Click-outside-to-close hit-target -->
		<control type="button">
			<left>-660</left>
			<top>-140</top>
			<width>1920</width>
			<height>1080</height>
			<texturefocus>-</texturefocus>
			<texturenofocus>-</texturenofocus>
			<label></label>
			<onclick>Action(close)</onclick>
		</control>

		<!-- Panel + accent + heading -->
		<control type="group">
			<left>0</left>
			<top>0</top>

			<!-- Panel background (auto-grows with grouplist via separate height) -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>110</height>
				<texture colordiffuse="bg_panel">white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>
			<control type="label">
				<left>30</left>
				<top>20</top>
				<width>540</width>
				<height>40</height>
				<font>font_med</font>
				<textcolor>accent_hi</textcolor>
				<aligny>center</aligny>
				<label>Actions</label>
			</control>
			<control type="label">
				<left>30</left>
				<top>62</top>
				<width>540</width>
				<height>30</height>
				<font>font_small</font>
				<textcolor>text_dim</textcolor>
				<scroll>true</scroll>
				<label>$INFO[ListItem.Label]</label>
			</control>

			<!-- Backdrop strip behind the menu list -->
			<control type="image">
				<left>0</left>
				<top>110</top>
				<width>600</width>
				<height max="780">auto</height>
				<texture colordiffuse="bg_panel">white.png</texture>
			</control>

			<!-- The actual menu items grouplist (Kodi clones button id=1000 into here) -->
			<control type="grouplist" id="996">
				<left>0</left>
				<top>110</top>
				<width>600</width>
				<height max="780">auto</height>
				<usecontrolcoords>true</usecontrolcoords>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<onleft>996</onleft>
				<onright>996</onright>
			</control>

		</control>

		<!-- Button template: Kodi clones one of these per menu action -->
		<control type="button" id="1000">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>30</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus>-</texturenofocus>
		</control>

	</controls>
</window>
