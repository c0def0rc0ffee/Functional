<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">15</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>410</posx>
		<posy>280</posy>
	</coordinates>
	<controls>

		<!-- Backdrop dim, lighter: this dialog stacks over the playlist editor -->
		<control type="image">
			<left>-410</left>
			<top>-280</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="80000000">white.png</texture>
		</control>

		<!-- Panel, solid colour so it stands out from the editor underneath -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1100</width>
			<height>520</height>
			<texture colordiffuse="FF181C22">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1100</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>516</top>
			<width>1100</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading -->
		<control type="label" id="2">
			<left>0</left>
			<top>20</top>
			<width>1100</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label>$LOCALIZE[21421]</label>
		</control>

		<!-- 15 = field, 16 = operator (Kodi fills both labels) -->
		<control type="button" id="15">
			<left>40</left>
			<top>100</top>
			<width>1020</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<onup>9000</onup>
			<ondown>16</ondown>
		</control>
		<control type="button" id="16">
			<left>40</left>
			<top>170</top>
			<width>1020</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<onup>15</onup>
			<ondown>17</ondown>
		</control>

		<!-- 17 = value, 20 = browse -->
		<control type="edit" id="17">
			<left>40</left>
			<top>240</top>
			<width>700</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<align>left</align>
			<aligny>center</aligny>
			<textoffsetx>20</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<onup>16</onup>
			<ondown>9000</ondown>
			<onleft>20</onleft>
			<onright>20</onright>
		</control>
		<control type="button" id="20">
			<left>760</left>
			<top>240</top>
			<width>300</width>
			<height>60</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<focusedcolor>white</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<align>center</align>
			<aligny>center</aligny>
			<textoffsetx>0</textoffsetx>
			<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
			<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
			<onup>16</onup>
			<ondown>9000</ondown>
			<onleft>17</onleft>
			<onright>17</onright>
			<label>$LOCALIZE[1024]</label>
		</control>

		<!-- Action buttons: 18 = OK, 19 = cancel -->
		<control type="grouplist" id="9000">
			<left>40</left>
			<top>430</top>
			<width>1020</width>
			<height>60</height>
			<orientation>horizontal</orientation>
			<itemgap>20</itemgap>
			<align>center</align>
			<onup>17</onup>
			<ondown>15</ondown>

			<control type="button" id="18">
				<width>240</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[186]</label>
			</control>
			<control type="button" id="19">
				<width>240</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[222]</label>
			</control>
		</control>

	</controls>
</window>
