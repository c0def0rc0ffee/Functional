<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<animation effect="fade" time="200">WindowOpen</animation>
	<animation effect="fade" time="200">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>$VAR[NotificationPosX]</posx>
		<posy>$VAR[NotificationPosY]</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>460</width>
			<height>140</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>

		<control type="image" id="401">
			<left>20</left>
			<top>20</top>
			<width>100</width>
			<height>100</height>
			<aspectratio>keep</aspectratio>
		</control>

		<control type="label" id="402">
			<left>140</left>
			<top>14</top>
			<width>300</width>
			<height>36</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<label></label>
		</control>

		<control type="textbox" id="403">
			<left>140</left>
			<top>54</top>
			<width>300</width>
			<height>72</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
		</control>

	</controls>
</window>
