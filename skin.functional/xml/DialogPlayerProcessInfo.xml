<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<controls>

		<!-- Bottom info bar. Pure readout: Kodi closes this dialog itself on
		     'o' / back, so there are no focusable controls. -->
		<control type="group">
			<left>0</left>
			<bottom>0</bottom>
			<width>1920</width>
			<height>310</height>

			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>310</height>
				<texture colordiffuse="bg_panel">white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>4</height>
				<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
			</control>

			<!-- Video column (playback pipeline) -->
			<control type="grouplist">
				<left>60</left>
				<top>24</top>
				<width>1000</width>
				<height>270</height>
				<orientation>vertical</orientation>
				<itemgap>4</itemgap>
				<visible>Player.HasVideo</visible>

				<control type="label">
					<width>1000</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[VideoPlayer.VideoCodec,[COLOR accent_hi]Video codec:[/COLOR] ]$INFO[VideoPlayer.VideoBitrate,$COMMA , kb/s]</label>
				</control>
				<control type="label">
					<width>1000</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[Player.Process(videodecoder),[COLOR accent_hi]Video decoder:[/COLOR] ]</label>
				</control>
				<control type="label">
					<width>1000</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[Player.Process(pixformat),[COLOR accent_hi]Pixel format:[/COLOR] ]</label>
				</control>
				<control type="label">
					<width>1000</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[Player.Process(deintmethod),[COLOR accent_hi]Deinterlace:[/COLOR] ]</label>
				</control>
				<control type="label">
					<width>1000</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[Player.Process(videowidth),[COLOR accent_hi]Video size:[/COLOR] ,x]$INFO[Player.Process(videoheight)]$INFO[Player.Process(videoscantype)]$INFO[Player.Process(videodar),$COMMA , AR]$INFO[Player.Process(videofps),$COMMA , fps]</label>
				</control>
			</control>

			<!-- Audio + system column -->
			<control type="grouplist">
				<left>1120</left>
				<top>24</top>
				<width>740</width>
				<height>270</height>
				<orientation>vertical</orientation>
				<itemgap>4</itemgap>

				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>[COLOR accent_hi]Audio:[/COLOR] $INFO[Player.Process(audiochannels),,$COMMA ]$INFO[Player.Process(audiodecoder)]$INFO[Player.Process(audiobitspersample),$COMMA , bits]$INFO[Player.Process(audiosamplerate),$COMMA , Hz]</label>
				</control>
				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[VideoPlayer.AudioCodec,[COLOR accent_hi]Audio codec:[/COLOR] ]$INFO[VideoPlayer.AudioChannels,$COMMA , ch]</label>
				</control>
				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[System.ScreenResolution,[COLOR accent_hi]Screen:[/COLOR] ]</label>
				</control>
				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[System.FPS,[COLOR accent_hi]GUI:[/COLOR] , fps]</label>
				</control>
				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[System.CpuUsage,[COLOR accent_hi]CPU:[/COLOR] ]</label>
					<visible>System.SupportsCPUUsage</visible>
				</control>
				<control type="label">
					<width>740</width>
					<height>48</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[System.Memory(used.percent),[COLOR accent_hi]Memory:[/COLOR] ]</label>
					<visible>!System.SupportsCPUUsage</visible>
				</control>
			</control>

		</control>

	</controls>
</window>
