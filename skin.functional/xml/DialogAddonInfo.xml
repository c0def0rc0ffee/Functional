<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Addon info dialog.
  </summary>
  <remarks>
  Kodi-assigned action button IDs (Omega):
     6 = Install / Uninstall (plain button, Kodi writes the label)
     7 = Enable / Disable    (plain button, Kodi writes the label)
     8 = Update
     9 = Configure (open addon settings)
    10 = Dependencies
    12 = Open / Launch
    13 = Auto-update         (radio)
    14 = Versions

  Kodi only SET_CONTROL_VISIBLE/HIDDENs buttons 8 and 14 (they are mutually
  exclusive: Update shows when an update is available, Versions otherwise):
  never add a skin-side <visible> to those two, it would override Kodi's
  show/hide. Everything else is only ever enabled/disabled, so a
  <visible>Control.IsEnabled(N)</visible> gate is safe there (Estuary gates
  13 this way).

  The button row is set in font_small. At font_reg Dependencies measures
  173 px and Auto-update 153 px, which did not fit a row of seven in the
  1140 px between the margins; at font_small they are 134 and 118. The
  worst case (12, 9, 13, 10, 7, 8 or 14, and 6 all visible) is six
  buttons of 145, the radio button at 222 and six 8 px gaps:
  870 + 222 + 48 = 1140.

  6 and 7 must stay plain buttons. As togglebuttons they flipped to their
  selected state on every press and drew alt textures that were never
  defined, so after one press the button lost its background and its
  focus fill. Kodi only ever writes their label, never a selected state.

  The panel uses the opaque bg_dialog: through the translucent bg_panel
  the add-on list behind showed in the description.
  </remarks>
-->
<window type="dialog">
	<defaultcontrol always="true">9000</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>360</posx>
		<posy>180</posy>
	</coordinates>
	<controls>

		<!-- Dim backdrop -->
		<control type="image">
			<left>-360</left>
			<top>-180</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Panel -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>720</height>
			<texture colordiffuse="bg_dialog">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Thumb left -->
		<control type="image">
			<left>30</left>
			<top>30</top>
			<width>240</width>
			<height>240</height>
			<aspectratio>scale</aspectratio>
			<texture fallback="DefaultAddon.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
		</control>

		<!-- Title -->
		<control type="label">
			<left>300</left>
			<top>30</top>
			<width>870</width>
			<height>50</height>
			<font>font_big</font>
			<textcolor>text</textcolor>
			<label>$INFO[ListItem.AddonName]</label>
			<scroll>true</scroll>
		</control>
		<!-- Version + author -->
		<control type="label">
			<left>300</left>
			<top>84</top>
			<width>870</width>
			<height>26</height>
			<font>font_small</font>
			<textcolor>$VAR[AccentColor]</textcolor>
			<label>v$INFO[ListItem.AddonVersion]$INFO[ListItem.AddonCreator, · ,]</label>
		</control>
		<!-- Type / origin / size -->
		<control type="label">
			<left>300</left>
			<top>114</top>
			<width>870</width>
			<height>26</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<label>$INFO[ListItem.AddonType]$INFO[ListItem.AddonOrigin,   ·   ]$INFO[ListItem.AddonSize,   ·   ]</label>
		</control>

		<!-- Description -->
		<control type="textbox">
			<left>300</left>
			<top>160</top>
			<width>870</width>
			<!-- ten 35 px lines of font_reg; at 340 the last line was cut in half -->
			<height>350</height>
			<font>font_reg</font>
			<textcolor>text</textcolor>
			<!-- The news element of the add-on's manifest, which for this skin
			     is its changelog section, follows the description. -->
			<label>$INFO[ListItem.AddonSummary,[B],[/B][CR][CR]]$INFO[ListItem.AddonDescription]$INFO[ListItem.AddonNews,[CR][CR][B]$LOCALIZE[24054][/B][CR],]</label>
			<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
		</control>

		<!-- Disclaimer (only if present) -->
		<control type="textbox">
			<left>30</left>
			<top>514</top>
			<width>1140</width>
			<!-- two 27 px lines of font_small -->
			<height>54</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<align>center</align>
			<label>[I]$INFO[ListItem.AddonDisclaimer][/I]</label>
			<visible>!String.IsEmpty(ListItem.AddonDisclaimer)</visible>
		</control>

		<!-- Action buttons (Kodi enables/disables per addon state) -->
		<control type="grouplist" id="9000">
			<left>30</left>
			<top>610</top>
			<width>1140</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>8</itemgap>
			<align>center</align>
			<onleft>9000</onleft>
			<onright>9000</onright>

			<!-- 12 = Open / Launch -->
			<control type="button" id="12">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[518]</label>
			</control>
			<!-- 9 = Configure / Settings -->
			<control type="button" id="9">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24020]</label>
			</control>
			<!-- 13 = Auto-update toggle. Kodi draws three things in a radiobutton:
			     the label from the left offset, an On or Off word ending at the
			     right offset, and the 16 px radio square 8 px in from the right
			     edge. With an offset of 30 in 222 the label runs 30..148, the word
			     ends at 192 and the square sits at 198..214, so none of them
			     overlap; at 180 wide in font_reg the square sat on the text. -->
			<control type="radiobutton" id="13">
				<visible>Control.IsEnabled(13)</visible>
				<width>222</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>30</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<textureradioonfocus colordiffuse="white">white.png</textureradioonfocus>
				<textureradioonnofocus colordiffuse="$VAR[AccentColor]">white.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="grey">white.png</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="grey_dark">white.png</textureradiooffnofocus>
				<label>$LOCALIZE[21340]</label>
			</control>
			<!-- 10 = Dependencies -->
			<control type="button" id="10">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[39024]</label>
			</control>
			<!-- 7 = Enable / Disable (Kodi writes whichever applies) -->
			<control type="button" id="7">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24022]</label>
			</control>
			<!-- 8 = Update (Kodi hides it when no update is available) -->
			<control type="button" id="8">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24138]</label>
			</control>
			<!-- 14 = Versions (Kodi hides it when an update is available) -->
			<control type="button" id="14">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24069]</label>
			</control>
			<!-- 6 = Install / Uninstall (Kodi writes whichever applies) -->
			<control type="button" id="6">
				<width>145</width>
				<height>70</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<disabledcolor>disabled</disabledcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24038]</label>
			</control>

		</control>

	</controls>
</window>
