<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Corner progress readout for long running jobs such as library scans.
  Kodi drives the fixed id label and progress controls.
  </summary>
-->
<window type="dialog">
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>1300</posx>
		<posy>900</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>580</width>
			<height>140</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>

		<control type="group" id="900">
			<left>20</left>
			<top>20</top>

			<control type="label" id="30">
				<left>0</left>
				<top>0</top>
				<width>540</width>
				<height>30</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<label></label>
			</control>
			<control type="label" id="31">
				<left>0</left>
				<top>34</top>
				<width>540</width>
				<height>26</height>
				<font>font_small</font>
				<textcolor>text_dim</textcolor>
				<label></label>
			</control>
			<control type="progress" id="32">
				<left>0</left>
				<top>74</top>
				<width>540</width>
				<height>8</height>
				<!-- Defaults.xml is inert, so a progress control with no textures
				     draws nothing: this bar was invisible during library scans. -->
				<texturebg colordiffuse="20FFFFFF">white.png</texturebg>
				<midtexture colordiffuse="$VAR[AccentColor]">white.png</midtexture>
				<overlaytexture>-</overlaytexture>
			</control>

		</control>

	</controls>
</window>
