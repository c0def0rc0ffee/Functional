				<include content="FavCategoryButton"><param name="id" value="72" /><param name="cat" value="movies" /><param name="label" value="Movies" /></include>
				<include content="FavCategoryButton"><param name="id" value="73" /><param name="cat" value="tvshows" /><param name="label" value="TV" /></include>
