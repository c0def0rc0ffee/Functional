				<include content="FavCategoryButton"><param name="id" value="75" /><param name="cat" value="apps" /><param name="label" value="Apps" /></include>
				<include content="FavCategoryButton"><param name="id" value="76" /><param name="cat" value="other" /><param name="label" value="Other" /></include>
		</control>

		<!-- Favourites list (static; items follow the selected category) -->
