<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Custom Favourites window (id 1150).

  This is a skin-owned custom window, NOT favouritesbrowser (10060). That
  window is a CGUIMediaWindow: Kodi binds its own favourites:// content into
  the skin's view container, clobbering our static filtered list — which broke
  both the category filtering and focus behaviour. Hosting the UI in a custom
  window keeps Kodi's hands off it. MyFavourites.xml redirects here so remote
  keys / keymaps that open favouritesbrowser land on this screen too.

  The helper service parses favourites.xml, classifies each entry
  (Movies / TV / Music / Apps / Other) and publishes Fav.* properties on the
  Home window for the selected category. The category chips set
  Skin.String(fav_category); the list is a static list whose items bind to
  Fav.N.* and hide themselves when empty, so its length follows the active
  filter. Clicking an item sets Skin.String(fav_run) and the service executes
  that favourite's stored action.
-->
<window id="1150" type="window">
	<defaultcontrol always="true">50</defaultcontrol>
	<controls>

		<include content="WindowBackground"/>
		<include content="HeaderBar">
			<param name="title" value="     Favourites"/>
