<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">9000</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>660</posx>
		<posy>340</posy>
	</coordinates>
	<controls>

		<control type="image">
			<left>-660</left>
			<top>-340</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>600</width>
			<height>500</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>

		<control type="label">
			<left>0</left>
			<top>20</top>
			<width>600</width>
			<height>60</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label>Power</label>
		</control>

		<control type="grouplist" id="9000">
			<left>60</left>
			<top>110</top>
			<width>480</width>
			<height>360</height>
			<itemgap>10</itemgap>
			<orientation>vertical</orientation>

			<control type="button">
				<width>480</width>
				<label>Exit Kodi</label>
				<onclick>Quit</onclick>
			</control>
			<control type="button">
				<width>480</width>
				<label>Suspend</label>
				<onclick>Suspend</onclick>
			</control>
			<control type="button">
				<width>480</width>
				<label>Hibernate</label>
				<onclick>Hibernate</onclick>
			</control>
			<control type="button">
				<width>480</width>
				<label>Reboot</label>
				<onclick>Reboot</onclick>
			</control>
			<control type="button">
				<width>480</width>
				<label>Shutdown</label>
				<onclick>Shutdown</onclick>
			</control>
		</control>

	</controls>
</window>
