					<font>font_reg</font>
					<textcolor>text</textcolor>
					<label>$INFO[Skin.String(stat_tvshows_total)]</label>
				</control>

				<control type="label">
					<left>0</left>
					<top>320</top>
					<width>160</width>
					<height>34</height>
					<font>font_reg</font>
					<textcolor>text_dim</textcolor>
					<label>31092</label>
				</control>
				<control type="label">
					<left>180</left>
					<top>320</top>
					<width>130</width>
