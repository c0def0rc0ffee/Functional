				<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9100)">9100</ondown>
				<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9110)">9110</ondown>
				<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9120)">9120</ondown>
