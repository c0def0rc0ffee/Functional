						<texturenofocus>-</texturenofocus>
						<disabledcolor>disabled</disabledcolor>
						<label></label>
						<visible>$EXP[engage_block_shown]</visible>
						<onclick>RunScript(service.engage)</onclick>
						<onleft>9311</onleft>
						<onright>9001</onright>
						<onup>9000</onup>
						<ondown>9000</ondown>
					</control>
					<control type="label">
						<left>0</left>
						<top>650</top>
						<width>310</width>
						<height>40</height>
						<font>font_med</font>
						<textcolor>$VAR[AccentColor]</textcolor>
						<label>31634</label>
					</control>
					<control type="image">
						<left>0</left>
						<top>694</top>
						<width>310</width>
						<height>2</height>
						<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					</control>
					<control type="label">
						<left>0</left>
