						<height>34</height>
						<font>font_reg</font>
						<textcolor>text</textcolor>
						<label>$INFO[Window(home).Property(Engage.Next.When)]</label>
					</control>
				</control>

			</control>
		</definition>
	</include>

	<!-- <summary>STAGE-GROUNDWORK: the logo. flip_logo shows it the other way round while true.</summary> -->
	<include name="HomeLogo">
		<param name="flip_logo" default="false"/>
		<definition>
			<!-- Functional logo top-left -->
			<control type="image">
				<left>40</left>
				<top>30</top>
				<width>120</width>
				<height>120</height>
				<aspectratio>keep</aspectratio>
				<texture>logo.png</texture>
				<visible>[[!Skin.HasSetting(hide_logo) + !$PARAM[flip_logo]] | [Skin.HasSetting(hide_logo) + $PARAM[flip_logo]]]</visible>
			</control>
		</definition>
	</include>

	<!-- <summary>STAGE-GROUNDWORK: the weather line and its button. flip_weather shows it the other way round while true.</summary> -->
	<include name="HomeWeather">
		<param name="flip_weather" default="false"/>
		<definition>
			<!-- Weather widget, sits beneath the date, right-aligned in the
			     same column. Same font_small as the date so the three lines
			     (time / date / weather) read as one block. The group's condition
			     is $EXP[weather_widget_shown] so that navigation can name it:
			     Control.IsVisible(9006) reads the button's own state, which is
			     always visible, and says nothing about this group. -->
			<control type="group">
				<visible>[[$EXP[weather_widget_shown] + !$PARAM[flip_weather]] | [!$EXP[weather_widget_shown] + $PARAM[flip_weather]]]</visible>
				<control type="label">
					<right>40</right>
					<top>118</top>
					<width>700</width>
					<height>32</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[Weather.Temperature], $INFO[Weather.Conditions]</label>
				</control>
				<control type="button" id="9006">
					<right>20</right>
					<top>118</top>
					<width>720</width>
					<height>32</height>
					<disabledcolor>disabled</disabledcolor>
					<texturefocus colordiffuse="40FFFFFF">white.png</texturefocus>
					<texturenofocus>-</texturenofocus>
					<onclick>ActivateWindow(Weather)</onclick>
					<!-- The widget is one stop in the column of things on the top
					     edge: the Continue tab above it when that tab is at the top,
					     and below it whichever of the corner bar and the menu sits
					     higher. The menu and the bar send Up here in turn, so the
					     widget is reachable in every layout. -->
					<onup condition="Control.IsVisible(9211)">9211</onup>
					<onup condition="Control.IsVisible(9213)">9213</onup>
					<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9100)">9100</ondown>
					<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9110)">9110</ondown>
					<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9120)">9120</ondown>
					<ondown>9000</ondown>
				</control>
			</control>
		</definition>
	</include>

	<!-- <summary>STAGE-GROUNDWORK: the clock and date. flip_datetime shows them the other way round while true; the greeting's own switch is read inside $VAR[HomeClockLine] and is not flipped here.</summary> -->
	<include name="HomeClock">
		<param name="flip_datetime" default="false"/>
		<definition>
			<!-- Date / time top-right: time at y 40 to 80, date at y 84 to 116,
			     both right aligned at right=40, with the weather line under
			     them at y 118 to 150. -->
			<control type="group">
				<visible>[[!Skin.HasSetting(hide_datetime) + !$PARAM[flip_datetime]] | [Skin.HasSetting(hide_datetime) + $PARAM[flip_datetime]]]</visible>
				<!-- GREETING: $VAR[HomeClockLine] is the time alone unless show_greeting
				     is set, when a greeting (and the profile name, given more than one
				     profile) goes in front of it. Right aligned, so the extra width
				     only matters once there is more text. -->
				<control type="label">
					<right>40</right>
					<top>40</top>
					<width>900</width>
					<height>40</height>
					<font>font_med</font>
					<textcolor>text</textcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$VAR[HomeClockLine]</label>
				</control>
				<control type="label">
					<right>40</right>
					<top>84</top>
					<width>600</width>
					<height>32</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[System.Date]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- <summary>STAGE-GROUNDWORK: the version footer. flip_version shows it the other way round while true.</summary> -->
	<include name="HomeFooter">
		<param name="flip_version" default="false"/>
		<definition>
			<!-- Footer hint -->
			<control type="label">
				<left>60</left>
				<bottom>40</bottom>
				<width>1000</width>
				<height>40</height>
				<font>font_small</font>
				<textcolor>text_dim</textcolor>
				<label>$LOCALIZE[31097]$INFO[System.AddonVersion(skin.functional)]</label>
				<visible>[[!Skin.HasSetting(hide_version) + !$PARAM[flip_version]] | [Skin.HasSetting(hide_version) + $PARAM[flip_version]]]</visible>
				<!-- Bottom left is the one corner placement that lands on this
				     label. Lift it clear rather than hide it: the user asked for
				     the version line, and it reads fine one row up. -->
				<animation effect="slide" end="0,-80" time="0" condition="$EXP[corner_bar_bottom_left]">Conditional</animation>
			</control>
		</definition>
	</include>

	<!-- <summary>STAGE-GROUNDWORK: the Continue Watching and Recently Added tabs on both edges. flip_continue and flip_recent show a tab the other way round while true.</summary> -->
	<include name="HomeContinueTabs">
		<param name="flip_continue" default="false"/>
		<param name="flip_recent" default="false"/>
		<definition>
			<!-- The Continue Watching tab, one button per edge so the nav
			     conditions elsewhere can name the visible one. -->
			<!-- Bottom edge, the default -->
			<control type="button" id="9210">
				<!-- Anything but "top" is bottom, so a left or right value saved by
				     0.11.1 still shows a tab. -->
				<visible>[[$EXP[continue_tab_shown] + !$PARAM[flip_continue]] | [!$EXP[continue_tab_shown] + $PARAM[flip_continue]]] + !$EXP[continue_tab_top]</visible>
				<animation effect="fade" time="200" condition="!Skin.HasSetting(reduce_motion)">VisibleChange</animation>
				<!-- Makes room for the Recently Added tab on the same edge. -->
				<animation effect="slide" end="-160,0" time="0" condition="[[$EXP[recent_tab_shown] + !$PARAM[flip_recent]] | [!$EXP[recent_tab_shown] + $PARAM[flip_recent]]]">Conditional</animation>
				<left>810</left>
				<top>1044</top>
				<width>300</width>
				<height>36</height>
				<font>font_small</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="bg_panel">white.png</texturenofocus>
				<label>31385</label>
				<!-- Every condition here is read before any line runs (Kodi
				     snapshots them at click time). Open on the Recently Added
				     page: switch page and stay open. Open on this page: close.
				     Closed: open on this page. The focus hops fire whenever the
				     panel is about to show this page. -->
				<onclick condition="Skin.HasSetting(continue_open) + !$EXP[recent_page]">Skin.Reset(continue_open)</onclick>
				<onclick condition="!Skin.HasSetting(continue_open)">Skin.SetBool(continue_open)</onclick>
				<onclick>Skin.Reset(home_panel)</onclick>
				<onclick condition="!Skin.HasSetting(continue_open) | $EXP[recent_page]">SetFocus(9201)</onclick>
				<onclick condition="[!Skin.HasSetting(continue_open) | $EXP[recent_page]] + Integer.IsEqual(Container(9201).NumItems,0)">SetFocus(9203)</onclick>
