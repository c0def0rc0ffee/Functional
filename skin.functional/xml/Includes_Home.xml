					<animation effect="slide" end="0,-220" time="0" condition="!$EXP[jellystat_block_shown]">Conditional</animation>
					<control type="button" id="9320">
						<left>-10</left>
						<top>646</top>
						<width>330</width>
						<height>138</height>
