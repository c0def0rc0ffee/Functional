						<width>160</width>
						<height>34</height>
						<font>font_reg</font>
						<textcolor>text_dim</textcolor>
						<label>31403</label>
					</control>
					<control type="label">
						<left>160</left>
						<top>540</top>
						<width>150</width>
						<height>34</height>
						<font>font_reg</font>
						<textcolor>text</textcolor>
						<align>right</align>
						<label>$INFO[Window(home).Property(JellyStat.Month.Titles)]</label>
