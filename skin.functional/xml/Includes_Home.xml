	<!-- <summary>STAGE, 05/11/2026 (roadmap item 47): the main menu grouplist and its tiles, moved out of Home.xml unchanged. id is the grouplist's id and p the first two digits of the tile ids (9001 to 9028 on Home); the stage passes 9900 and 99 because Skin Settings has groups 9000 to 9007 of its own.</summary> -->
	<include name="HomeMenu">
		<param name="id" default="9000"/>
		<param name="p" default="90"/>
		<definition>
			<!-- Main menu, vertical position via Skin.String(menu_position) -->
			<control type="grouplist" id="$PARAM[id]">
				<!-- Top: y 40 to 180, clear of the 36px Continue tab on the top edge
				     and of the corner bar when that is at the top (y 180 to 250).
				     Bottom: y 820 to 960 while the corner bar holds the bottom edge
				     (y 970 to 1040), the full 440 only once the bar has moved to the
				     top. Each tile is the HomeTile include below.

				     TILE-ROW-WIDTH: the row has to stay out of whatever shares its
				     band, for one to eight tiles. A button's width cannot follow a
				     condition, so every slot is three buttons of which one shows,
				     picked by Window(home).Property(Tile.Count) (the number of tiles
				     showing, from service.py:update_tiles): 220 wide up to six tiles,
				     188 at seven, 162 with the smaller font at eight. With the 20
				     gap that is 220, 460, 700, 940, 1180, 1420, 1436, 1436 wide.
				     Centre: the stats column starts at x 1550, so while any stats
				     block shows a row of five or more tiles is centred on x 775
				     instead of 960 (slide 185 left) and its widest forms end at
				     x 1493, 57 clear. Up to four tiles stay on the screen centre,
				     where four end at x 1430 and five would touch the column;
				     a short row beside the column looked off centre otherwise.
				     Before the service has published Tile.Count the row is slid,
				     which is what it always was.
				     Top: up to five tiles span x 370 to 1550 on the screen centre
				     and need nothing. From six the row is centred on x 880 (slide
				     80 left): six span x 170 to 1590, seven and eight x 162 to
				     1598, right of the logo (ends x 160). The date under the
				     clock is right aligned and starts between x 1580 (the longest
				     day and month) and x 1650; the last tile's box may reach 18
				     into the longest one, a built in caption never does.
				     Bottom: nothing shares the band, the row stays on x 960 and
				     at its widest spans x 242 to 1678, which just clears the
				     version line (text ends near x 241) under a top corner bar.
				     Until the service has published Tile.Count the 220 buttons
				     show, which is what the row always was. -->
				<animation effect="slide" end="0,-440" time="0" condition="$EXP[menu_top]">Conditional</animation>
				<animation effect="slide" end="0,440" time="0" condition="$EXP[menu_bottom] + $EXP[corner_bar_top]">Conditional</animation>
				<animation effect="slide" end="0,340" time="0" condition="$EXP[menu_bottom] + !$EXP[corner_bar_top]">Conditional</animation>
				<animation effect="slide" end="-185,0" time="0" condition="!$EXP[menu_top] + !$EXP[menu_bottom] + $EXP[home_stats_shown] + [String.IsEmpty(Window(home).Property(Tile.Count)) | Integer.IsGreater(Window(home).Property(Tile.Count),4)]">Conditional</animation>
				<animation effect="slide" end="-80,0" time="0" condition="$EXP[menu_top] + Integer.IsGreater(Window(home).Property(Tile.Count),5)">Conditional</animation>
				<left>0</left>
				<top>480</top>
				<width>1920</width>
				<height>140</height>
				<itemgap>20</itemgap>
				<orientation>horizontal</orientation>
				<align>center</align>
				<!-- HOME-VERTICAL-NAV: Kodi takes the first condition that holds.
				     $EXP[bar_above_menu] is the corner bar on the top edge with the
				     menu NOT at the top; with both at the top the bar (y 180 to
				     250) lies below the menu (y 40 to 180), which the plain
				     corner_bar_top test used to get backwards. Only one of the
				     three bar instances is ever visible, hence three lines each
				     time. When the menu is the higher of the two, Up goes to the
				     weather widget if it shows, then to a Continue tab on the top
				     edge; the widget's own Up carries on to that tab.
				     The service focuses the bar when every tile is Off, and these
				     lines are also what Kodi follows THROUGH this grouplist when it
				     has no focusable child, so each direction has to end on
				     something that can take focus or on this id itself. -->
				<!-- BG-ADD: a caption's Add To List button on the top edge is
				     the nearest thing above, on the bottom edge the nearest
				     below; BG-STEP: the edge buttons are what lies left and
				     right of the row. -->
				<onup condition="Control.IsVisible(9300)">9300</onup>
				<onup condition="Control.IsVisible(9301)">9301</onup>
				<onup condition="$EXP[bar_above_menu] + Control.IsVisible(9100)">9100</onup>
				<onup condition="$EXP[bar_above_menu] + Control.IsVisible(9110)">9110</onup>
				<onup condition="$EXP[bar_above_menu] + Control.IsVisible(9120)">9120</onup>
				<onup condition="$EXP[weather_widget_shown]">9006</onup>
				<onup condition="Control.IsVisible(9211)">9211</onup>
				<onup condition="Control.IsVisible(9213)">9213</onup>
				<!-- Down reaches the corner bar whenever it lies below the menu:
				     on the bottom edge, or on the top edge under a top menu. With
				     the bar above the menu, a Continue tab on the bottom edge is
				     what lies below. -->
				<ondown condition="Control.IsVisible(9302)">9302</ondown>
				<ondown condition="Control.IsVisible(9303)">9303</ondown>
				<ondown condition="Control.IsVisible(9304)">9304</ondown>
				<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9210)">9210</ondown>
				<ondown condition="$EXP[bar_above_menu] + Control.IsVisible(9212)">9212</ondown>
				<ondown condition="$EXP[bar_above_menu]">9000</ondown>
				<ondown condition="Control.IsVisible(9110)">9110</ondown>
				<ondown condition="Control.IsVisible(9120)">9120</ondown>
				<ondown>9100</ondown>
				<!-- Unconditional on purpose: a grouplist's end of row targets
				     are fixed when the window loads (AddControl wires the last
				     tile back to the first when the row's own action has no
				     condition that holds then), and the edge buttons are never
				     visible that early. While they are hidden Kodi falls
				     through to their own onleft/onright, which point back here. -->
				<onleft>9310</onleft>
				<onright>9311</onright>

				<!-- Eight slots, each a built in screen or any favourite, set on the
				     Main Menu settings page; with nothing set they are the menu as it
				     always was. Three buttons per slot, one per width (see
				     TILE-ROW-WIDTH above): the 220 ones keep the old ids (9006
				     belongs to the weather widget), 9011 to 9018 are the 188 ones
				     and 9021 to 9028 the 162 ones. Nothing navigates to a tile by
				     id, only to this grouplist. -->
				<include content="HomeTile"><param name="n" value="1" /><param name="id" value="$PARAM[p]01" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="1" /><param name="id" value="$PARAM[p]11" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="1" /><param name="id" value="$PARAM[p]21" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="2" /><param name="id" value="$PARAM[p]02" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="2" /><param name="id" value="$PARAM[p]12" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="2" /><param name="id" value="$PARAM[p]22" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="3" /><param name="id" value="$PARAM[p]03" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="3" /><param name="id" value="$PARAM[p]13" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="3" /><param name="id" value="$PARAM[p]23" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="4" /><param name="id" value="$PARAM[p]04" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="4" /><param name="id" value="$PARAM[p]14" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="4" /><param name="id" value="$PARAM[p]24" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="5" /><param name="id" value="$PARAM[p]05" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="5" /><param name="id" value="$PARAM[p]15" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="5" /><param name="id" value="$PARAM[p]25" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="6" /><param name="id" value="$PARAM[p]07" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="6" /><param name="id" value="$PARAM[p]16" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="6" /><param name="id" value="$PARAM[p]26" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="7" /><param name="id" value="$PARAM[p]08" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="7" /><param name="id" value="$PARAM[p]17" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="7" /><param name="id" value="$PARAM[p]27" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>
				<include content="HomeTile"><param name="n" value="8" /><param name="id" value="$PARAM[p]09" /><param name="when" value="$EXP[tiles_wide]" /></include>
				<include content="HomeTile"><param name="n" value="8" /><param name="id" value="$PARAM[p]18" /><param name="width" value="188" /><param name="when" value="$EXP[tiles_mid]" /></include>
				<include content="HomeTile"><param name="n" value="8" /><param name="id" value="$PARAM[p]28" /><param name="width" value="162" /><param name="font" value="font_reg" /><param name="when" value="$EXP[tiles_narrow]" /></include>

			</control>
		</definition>
	</include>

	<!-- <summary>STAGE, 05/11/2026 (roadmap item 47): Home at 18.75 per cent, drawn from the same includes as Home, for the preview panel under the help text in Skin Settings. Each flip is the focus of the row that switches that setting, so the stage shows what OK would do; the tabs are shown on their settings alone, since Home's containers are not here; the outlines mark the region the focused row changes.</summary> -->
