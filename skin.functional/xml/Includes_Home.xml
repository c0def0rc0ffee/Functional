					</control>
					<control type="image">
						<left>0</left>
						<top>484</top>
						<width>310</width>
						<height>2</height>
						<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					</control>
					<control type="label">
						<left>0</left>
						<top>500</top>
						<width>160</width>
						<height>34</height>
						<font>font_reg</font>
						<textcolor>text_dim</textcolor>
						<label>31401</label>
					</control>
					<control type="label">
						<left>160</left>
						<top>500</top>
						<width>150</width>
						<height>34</height>
						<font>font_reg</font>
						<textcolor>text</textcolor>
						<align>right</align>
