				<include content="HomeMenu"><param name="id" value="9900"/><param name="p" value="99"/></include>
				<include content="HomeCornerBar"><param name="id_bar" value="9930"/><param name="id_sleep" value="9931"/><param name="id_sleep_btn" value="9932"/><param name="id_resume" value="9933"/><param name="id_queue" value="9934"/><param name="id_stats" value="9935"/><param name="id_lists" value="9936"/><param name="id_fav" value="9937"/><param name="id_addons" value="9938"/><param name="id_settings" value="9939"/><param name="id_power" value="9940"/><param name="align" value="right"/><param name="left" value="480"/><param name="visible" value="$EXP[corner_bar_right]"/></include>
				<include content="HomeCornerBar"><param name="id_bar" value="9950"/><param name="id_sleep" value="9951"/><param name="id_sleep_btn" value="9952"/><param name="id_resume" value="9953"/><param name="id_queue" value="9954"/><param name="id_stats" value="9955"/><param name="id_lists" value="9956"/><param name="id_fav" value="9957"/><param name="id_addons" value="9958"/><param name="id_settings" value="9959"/><param name="id_power" value="9960"/><param name="align" value="left"/><param name="left" value="40"/><param name="visible" value="$EXP[corner_bar_left]"/></include>
				<include content="HomeCornerBar"><param name="id_bar" value="9970"/><param name="id_sleep" value="9971"/><param name="id_sleep_btn" value="9972"/><param name="id_resume" value="9973"/><param name="id_queue" value="9974"/><param name="id_stats" value="9975"/><param name="id_lists" value="9976"/><param name="id_fav" value="9977"/><param name="id_addons" value="9978"/><param name="id_settings" value="9979"/><param name="id_power" value="9980"/><param name="align" value="center"/><param name="left" value="260"/><param name="visible" value="$EXP[corner_bar_centre]"/></include>
				<include content="HomeFooter"><param name="flip_version" value="Control.HasFocus(7105)"/></include>
				<include content="HomeContinueTabs"><param name="flip_continue" value="Control.HasFocus(7128)"/><param name="flip_recent" value="Control.HasFocus(7144)"/><param name="shown_continue" value="!Skin.HasSetting(hide_continue)"/><param name="shown_recent" value="!Skin.HasSetting(hide_continue) + !Skin.HasSetting(hide_recent)"/></include>
				<!-- Region outlines: one per region, on the rows that change it. -->
				<include content="StageRegion"><param name="when" value="$EXP[stage_region_logo]"/><param name="left" value="20"/><param name="top" value="10"/><param name="width" value="160"/><param name="height" value="160"/></include>
				<include content="StageRegion"><param name="when" value="$EXP[stage_region_clock]"/><param name="left" value="960"/><param name="top" value="16"/><param name="width" value="940"/><param name="height" value="150"/></include>
				<include content="StageRegion"><param name="when" value="$EXP[stage_region_stats]"/><param name="left" value="1530"/><param name="top" value="160"/><param name="width" value="360"/><param name="height" value="640"/></include>
				<include content="StageRegion"><param name="when" value="$EXP[stage_region_tabs]"/><param name="left" value="560"/><param name="top" value="920"/><param name="width" value="800"/><param name="height" value="160"/></include>
				<include content="StageRegion"><param name="when" value="$EXP[stage_region_footer]"/><param name="left" value="20"/><param name="top" value="990"/><param name="width" value="640"/><param name="height" value="80"/></include>
			</control>
		</definition>
	</include>

	<!-- <summary>STAGE: an accent outline round one region of the stage, shown on the rows that change that region.</summary> -->
	<include name="StageRegion">
		<param name="when"/>
		<param name="left"/>
		<param name="top"/>
		<param name="width"/>
		<param name="height"/>
		<definition>
			<!-- Four bars rather than a border texture: at 18.75 per cent a
			     sliced frame thins to under a pixel, a 10 px bar keeps two. -->
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<visible>$PARAM[when]</visible>
				<control type="image"><left>0</left><top>0</top><width>$PARAM[width]</width><height>10</height><texture colordiffuse="$VAR[AccentColor]">white.png</texture></control>
				<control type="image"><left>0</left><top>0</top><width>10</width><height>$PARAM[height]</height><texture colordiffuse="$VAR[AccentColor]">white.png</texture></control>
				<control type="image"><left>0</left><top>$PARAM[height]</top><width>$PARAM[width]</width><height>10</height><texture colordiffuse="$VAR[AccentColor]">white.png</texture></control>
				<control type="image"><left>$PARAM[width]</left><top>0</top><width>10</width><height>$PARAM[height]</height><texture colordiffuse="$VAR[AccentColor]">white.png</texture></control>
			</control>
		</definition>
	</include>
</includes>
