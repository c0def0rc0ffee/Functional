				<onclick condition="[!Skin.HasSetting(continue_open) | $EXP[recent_page]] + Integer.IsEqual(Container(9201).NumItems,0) + Integer.IsEqual(Container(9203).NumItems,0) + $EXP[nextup_shown]">SetFocus(9205)</onclick>
				<!-- Down from the top tab lands on the corner bar only while the
