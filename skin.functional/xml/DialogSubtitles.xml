<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
	<defaultcontrol always="true">120</defaultcontrol>
	<animation effect="fade" time="150">WindowOpen</animation>
	<animation effect="fade" time="150">WindowClose</animation>
	<coordinates>
		<system>1</system>
		<posx>360</posx>
		<posy>120</posy>
	</coordinates>
	<controls>

		<!-- Dim backdrop -->
		<control type="image">
			<left>-360</left>
			<top>-120</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="C0000000">white.png</texture>
		</control>

		<!-- Panel -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>840</height>
			<texture colordiffuse="bg_panel">white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1200</width>
			<height>4</height>
			<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
		</control>

		<!-- Heading -->
		<control type="label">
			<left>0</left>
			<top>20</top>
			<width>1200</width>
			<height>50</height>
			<font>font_med</font>
			<align>center</align>
			<textcolor>text</textcolor>
			<label>Subtitles</label>
		</control>

		<!-- Currently playing filename -->
		<control type="label">
			<left>40</left>
			<top>74</top>
			<width>1120</width>
			<height>30</height>
			<font>font_small</font>
			<align>center</align>
			<textcolor>text_dim</textcolor>
			<label>$INFO[Player.Filename]</label>
			<scroll>true</scroll>
		</control>

		<!-- Action row. NOT id 130: that is core's "subs exist" group, which
		     Kodi force-hides whenever the playing file has no subtitle streams.
		     The only button core handles here is 160 = manual search. -->
		<control type="grouplist" id="190">
			<left>40</left>
			<top>120</top>
			<width>1120</width>
			<height>60</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<onleft>190</onleft>
			<onright>190</onright>
			<ondown>120</ondown>

			<control type="button" id="160">
				<width>380</width>
				<height>60</height>
				<font>font_reg</font>
				<textcolor>text</textcolor>
				<focusedcolor>white</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<texturefocus colordiffuse="$VAR[AccentColor]">white.png</texturefocus>
				<texturenofocus colordiffuse="grey_mid">white.png</texturenofocus>
				<label>$LOCALIZE[24120]</label>
			</control>
		</control>

		<!-- Search results list -->
		<control type="list" id="120">
			<left>40</left>
			<top>200</top>
			<width>1120</width>
			<height>540</height>
			<onleft>120</onleft>
			<onright>73</onright>
			<onup>190</onup>
			<onback>PreviousMenu</onback>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<pagecontrol>73</pagecontrol>

			<itemlayout height="60" width="1120">
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>40</width>
					<height>40</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>70</left>
					<top>0</top>
					<width>800</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>0</top>
					<width>240</width>
					<height>60</height>
					<font>font_small</font>
					<textcolor>text_dim</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="1120">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1120</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
					<visible>Control.HasFocus(120)</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>40</width>
					<height>40</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>70</left>
					<top>0</top>
					<width>800</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>20</right>
					<top>0</top>
					<width>240</width>
					<height>60</height>
					<font>font_small</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<align>right</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- Scrollbar -->
		<control type="scrollbar" id="73">
			<right>10</right>
			<top>200</top>
			<width>16</width>
			<height>540</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<onleft>120</onleft>
			<onright>120</onright>
			<texturesliderbackground colordiffuse="grey_mid">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="$VAR[AccentColor]">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="accent_hi">white.png</texturesliderbarfocus>
		</control>

		<!-- Service list (id 150), for choosing a subtitle service -->
		<control type="list" id="150">
			<left>40</left>
			<top>200</top>
			<width>1120</width>
			<height>540</height>
			<onleft>150</onleft>
			<onright>150</onright>
			<onup>190</onup>
			<onback>PreviousMenu</onback>
			<pagecontrol>73</pagecontrol>

			<itemlayout height="60" width="1120">
				<control type="label">
					<left>40</left>
					<top>0</top>
					<width>1080</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>text</textcolor>
					<selectedcolor>accent_hi</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="1120">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1120</width>
					<height>60</height>
					<texture colordiffuse="$VAR[AccentColor]">white.png</texture>
				</control>
				<control type="label">
					<left>40</left>
					<top>0</top>
					<width>1080</width>
					<height>60</height>
					<font>font_reg</font>
					<textcolor>white</textcolor>
					<selectedcolor>white</selectedcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- Status / footer (Kodi writes search status into id 140) -->
		<control type="label" id="140">
			<left>40</left>
			<bottom>30</bottom>
			<width>780</width>
			<height>40</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<align>left</align>
			<aligny>center</aligny>
			<label></label>
		</control>
		<!-- Active service name (Kodi writes it into id 100) -->
		<control type="label" id="100">
			<right>40</right>
			<bottom>30</bottom>
			<width>340</width>
			<height>40</height>
			<font>font_small</font>
			<textcolor>text_dim</textcolor>
			<align>right</align>
			<aligny>center</aligny>
			<label></label>
		</control>

		<!-- Hidden image id=110 (Kodi may write to this) -->
		<control type="image" id="110">
			<left>-2000</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
		</control>

	</controls>
</window>
