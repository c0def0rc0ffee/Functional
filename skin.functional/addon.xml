<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  <summary>
  Add-on manifest for the Functional skin: id, version, dependencies and
  extension points, including the service.py helper that keeps the skin's
  window properties and strings fed.
  </summary>
-->
<addon id="skin.functional" version="0.12.3" name="Functional" provider-name="c0def0rc0ffee">
	<requires>
		<!-- Kodi 21 (Omega) GUI version, matches the Flatpak build in use.
		     This is the value that installed cleanly before today. -->
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required for the service.py helper; kodi-addon-checker flags
		     services that don't declare the python API dependency. -->
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
	</extension>
	<!-- No start="login": the attribute is not in the add-on schema the
	     repository validates against, and Kodi has started services at
	     login regardless since well before Omega. -->
	<extension point="xbmc.service" library="service.py" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Functional: a clean, opinionated Kodi skin</summary>
		<description lang="en_GB">Functional. Built for clarity: gallery library views, configurable accent colour, slide-out filters, side-by-side library stats on home, and a tight video OSD.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
