<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!--
  <summary>
  Smart playlist: movies played at least once. Bundled so the skin can
  offer it without the user creating it.
  </summary>
-->
<smartplaylist type="movies">
    <name>Watched Movies</name>
    <match>all</match>
    <rule field="playcount" operator="greaterthan">
        <value>0</value>
    </rule>
</smartplaylist>
