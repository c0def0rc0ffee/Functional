<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!--
  <summary>
  Smart playlist: TV shows with no watched episodes. Bundled so the skin
  can offer it without the user creating it.
  </summary>
-->
<smartplaylist type="tvshows">
    <name>Unwatched TV shows</name>
    <match>all</match>
    <rule field="numwatched" operator="is">
        <value>0</value>
    </rule>
</smartplaylist>
